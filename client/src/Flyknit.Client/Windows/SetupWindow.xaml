<Window x:Class="Flyknit.Client.Windows.SetupWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="FlyknitBuddy"
        Width="460" SizeToContent="Height"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Background="#F4F6F9"
        Icon="/Assets/flyknitbuddy.png"
        FontFamily="Microsoft YaHei UI"
        FontSize="14">
    <Window.Resources>
        <Style TargetType="TextBox">
            <Setter Property="Height" Value="36" />
            <Setter Property="Padding" Value="8,0" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="BorderBrush" Value="#C9D0DB" />
            <Setter Property="Background" Value="White" />
        </Style>
        <Style TargetType="PasswordBox">
            <Setter Property="Height" Value="36" />
            <Setter Property="Padding" Value="8,0" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="BorderBrush" Value="#C9D0DB" />
            <Setter Property="Background" Value="White" />
        </Style>
        <Style x:Key="Primary" TargetType="Button">
            <Setter Property="Height" Value="40" />
            <Setter Property="Background" Value="#3446C9" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>
        <Style x:Key="Link" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Foreground" Value="#6B7587" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="Padding" Value="4,2" />
        </Style>
    </Window.Resources>
    <StackPanel Margin="28,24,28,20">
        <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
            <Image Source="/Assets/flyknitbuddy.png" Width="36" Height="36" />
            <TextBlock x:Name="TitleText" Margin="12,0,0,0" VerticalAlignment="Center" FontSize="19" FontWeight="SemiBold" Foreground="#1A2433" />
        </StackPanel>

        <!-- 安装包带了服务器地址和安装凭证：员工只需要点「登录」 -->
        <StackPanel x:Name="LoginPanel" Visibility="Collapsed">
            <TextBlock x:Name="LoginIntro" TextWrapping="Wrap" Foreground="#4F5B6D" Margin="0,0,0,16" />
            <Border Background="White" BorderBrush="#E1E5EC" BorderThickness="1" CornerRadius="8" Padding="14,10" Margin="0,0,0,14">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border Width="30" Height="30" CornerRadius="15" Background="#EEF0FC" VerticalAlignment="Center">
                        <TextBlock x:Name="AvatarText" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="#3446C9" FontWeight="SemiBold" />
                    </Border>
                    <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
                        <TextBlock x:Name="AccountText" Foreground="#1A2433" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                        <TextBlock x:Name="AccountHint" Foreground="#6B7587" FontSize="12" TextWrapping="Wrap" />
                    </StackPanel>
                </Grid>
            </Border>
            <StackPanel x:Name="PasswordArea" Visibility="Collapsed">
                <TextBlock x:Name="PasswordLabel" Foreground="#4F5B6D" FontSize="13" Margin="0,0,0,4" />
                <PasswordBox x:Name="PasswordBox" Margin="0,0,0,4" />
            </StackPanel>
            <TextBlock x:Name="ServerText" Foreground="#9AA3B2" FontSize="12" Margin="0,4,0,0" TextTrimming="CharacterEllipsis" />
        </StackPanel>

        <!-- 手动连接：没有安装包里的开通文件，或者 IT 让换服务器 -->
        <StackPanel x:Name="ManualPanel">
            <TextBlock x:Name="IntroText" TextWrapping="Wrap" Foreground="#4F5B6D" Margin="0,0,0,18" />
            <TextBlock x:Name="ServerLabel" Foreground="#4F5B6D" FontSize="13" Margin="0,0,0,4" />
            <TextBox x:Name="ServerBox" Text="http://" Margin="0,0,0,12" />
            <TextBlock x:Name="KeyLabel" Foreground="#4F5B6D" FontSize="13" Margin="0,0,0,4" />
            <TextBox x:Name="KeyBox" Margin="0,0,0,8" />
        </StackPanel>

        <TextBlock x:Name="ErrorText" TextWrapping="Wrap" Foreground="#C4362D" FontSize="13" Margin="0,8,0,0" Visibility="Collapsed" />

        <Button x:Name="ConnectButton" Style="{StaticResource Primary}" Margin="0,16,0,0" Click="OnConnect" IsDefault="True" />
        <Button x:Name="SwitchButton" Style="{StaticResource Link}" Margin="0,10,0,0" Click="OnSwitch" Visibility="Collapsed" />
    </StackPanel>
</Window>
