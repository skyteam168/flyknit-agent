<Window x:Class="Flyknit.Client.Windows.SetupWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Flyknit"
        Width="460" SizeToContent="Height"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Background="#F4F6F9"
        Icon="/Assets/flyknit.png"
        FontFamily="Microsoft YaHei UI"
        FontSize="14">
    <Window.Resources>
        <Style TargetType="TextBox">
            <Setter Property="Height" Value="36" />
            <Setter Property="Padding" Value="8,0" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="BorderBrush" Value="#C9D0DB" />
            <Setter Property="Background" Value="White" />
        </Style>
    </Window.Resources>
    <StackPanel Margin="28,24,28,24">
        <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
            <Image Source="/Assets/flyknit.png" Width="36" Height="36" />
            <TextBlock x:Name="TitleText" Margin="12,0,0,0" VerticalAlignment="Center" FontSize="19" FontWeight="SemiBold" Foreground="#1A2433" />
        </StackPanel>
        <TextBlock x:Name="IntroText" TextWrapping="Wrap" Foreground="#4F5B6D" Margin="0,0,0,18" />

        <TextBlock x:Name="ServerLabel" Foreground="#4F5B6D" FontSize="13" Margin="0,0,0,4" />
        <TextBox x:Name="ServerBox" Text="http://" Margin="0,0,0,12" />

        <TextBlock x:Name="KeyLabel" Foreground="#4F5B6D" FontSize="13" Margin="0,0,0,4" />
        <TextBox x:Name="KeyBox" Margin="0,0,0,8" />

        <TextBlock x:Name="ErrorText" TextWrapping="Wrap" Foreground="#C4362D" FontSize="13" Margin="0,4,0,0" Visibility="Collapsed" />

        <Button x:Name="ConnectButton" Height="38" Margin="0,16,0,0" Background="#3446C9" Foreground="White"
                BorderThickness="0" FontWeight="SemiBold" Click="OnConnect" IsDefault="True" />
    </StackPanel>
</Window>
