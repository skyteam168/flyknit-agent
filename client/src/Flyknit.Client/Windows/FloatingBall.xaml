<Window x:Class="Flyknit.Client.Windows.FloatingBall"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="FlyknitBuddy"
        Width="64" Height="64"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Topmost="True"
        AllowDrop="True">
    <Window.Resources>
        <!-- 右键菜单：白色圆角卡片 -->
        <Style x:Key="BallMenu" TargetType="ContextMenu">
            <Setter Property="OverridesDefaultStyle" Value="True" />
            <Setter Property="SnapsToDevicePixels" Value="True" />
            <Setter Property="HasDropShadow" Value="True" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ContextMenu">
                        <Border Background="#FFFFFF" CornerRadius="12" BorderBrush="#E6E8EE" BorderThickness="1"
                                Padding="6" Margin="4,4,10,10">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="16" ShadowDepth="3" Direction="270" Opacity="0.18" Color="#1A2433" />
                            </Border.Effect>
                            <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Cycle" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="BallMenuItem" TargetType="MenuItem">
            <Setter Property="OverridesDefaultStyle" Value="True" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="MenuItem">
                        <Border x:Name="Bd" Background="Transparent" CornerRadius="8" Padding="12,8" MinWidth="210">
                            <DockPanel>
                                <TextBlock DockPanel.Dock="Right" Text="{TemplateBinding InputGestureText}" Foreground="#9AA0AE"
                                           Margin="24,0,0,0" VerticalAlignment="Center" />
                                <ContentPresenter ContentSource="Header" RecognizesAccessKey="False" VerticalAlignment="Center"
                                                  TextBlock.Foreground="#1F2330" />
                            </DockPanel>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#F1F3F7" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.45" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="BallMenuSeparator" TargetType="Separator">
            <Setter Property="OverridesDefaultStyle" Value="True" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Separator">
                        <Border Height="1" Margin="8,5" Background="#ECEEF3" />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    <Grid x:Name="Root" Cursor="Hand">
        <Grid.RenderTransform>
            <ScaleTransform x:Name="Scale" CenterX="32" CenterY="32" ScaleX="1" ScaleY="1" />
        </Grid.RenderTransform>

        <!-- 状态光环：运行中为青色旋转，等待确认为琥珀色 -->
        <Ellipse x:Name="Halo" Width="60" Height="60" StrokeThickness="3" Opacity="0"
                 Stroke="#0E9A8E" StrokeDashArray="6 4" RenderTransformOrigin="0.5,0.5">
            <Ellipse.RenderTransform>
                <RotateTransform x:Name="HaloRotate" />
            </Ellipse.RenderTransform>
        </Ellipse>

        <Border Width="50" Height="50" CornerRadius="25" Background="#3446C9">
            <Border.Effect>
                <DropShadowEffect BlurRadius="14" ShadowDepth="3" Direction="270" Opacity="0.28" Color="#1A2433" />
            </Border.Effect>
            <Image Source="/Assets/flyknitbuddy.png" Width="50" Height="50">
                <Image.Clip>
                    <EllipseGeometry Center="25,25" RadiusX="25" RadiusY="25" />
                </Image.Clip>
            </Image>
        </Border>

        <Ellipse x:Name="Badge" Width="14" Height="14" Fill="#F0A43A" Stroke="White" StrokeThickness="2"
                 HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,6,6,0" Visibility="Collapsed" />
    </Grid>
</Window>
