<Window x:Class="Flyknit.Client.Windows.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        Title="FlyknitBuddy"
        Width="1040" Height="720"
        MinWidth="400" MinHeight="520"
        WindowStartupLocation="Manual"
        WindowStyle="None"
        ResizeMode="CanResize"
        Background="#F4F6F9"
        Icon="/Assets/flyknitbuddy.png"
        ShowInTaskbar="True">
    <!-- 无边框窗口：标题栏由网页绘制（app-region: drag），这里只保留可调整大小的边框 -->
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="0"
                      ResizeBorderThickness="6"
                      GlassFrameThickness="0"
                      CornerRadius="8"
                      UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>
    <Grid>
        <!-- 启动加载卡片：WebView2 页面加载完成前显示（WebView2 总在最上层，所以加载期间先隐藏它） -->
        <Border x:Name="LoadingCard"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Width="380"
                Padding="36,32"
                CornerRadius="16"
                Background="White"
                BorderBrush="#E6E8EE"
                BorderThickness="1">
            <Border.Effect>
                <DropShadowEffect BlurRadius="28" ShadowDepth="6" Direction="270" Opacity="0.10" Color="#1B2440" />
            </Border.Effect>
            <StackPanel HorizontalAlignment="Center">
                <!-- 加载动画：标志轻轻呼吸，外圈一段弧在转（和页面里的加载动画一致） -->
                <Grid Width="76" Height="76" Margin="0,0,0,18" HorizontalAlignment="Center">
                    <Ellipse Stroke="#E9EBF2" StrokeThickness="3" />
                    <Path Stroke="#3446C9" StrokeThickness="3" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                          Data="M 38,1.5 A 36.5,36.5 0 0 1 74.5,38" RenderTransformOrigin="0.5,0.5">
                        <Path.RenderTransform>
                            <RotateTransform Angle="0" />
                        </Path.RenderTransform>
                        <Path.Triggers>
                            <EventTrigger RoutedEvent="Loaded">
                                <BeginStoryboard>
                                    <Storyboard RepeatBehavior="Forever">
                                        <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(RotateTransform.Angle)"
                                                         From="0" To="360" Duration="0:0:1.1" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </EventTrigger>
                        </Path.Triggers>
                    </Path>
                    <Image Source="/Assets/flyknitbuddy.png" Width="50" Height="50" RenderTransformOrigin="0.5,0.5"
                           RenderOptions.BitmapScalingMode="HighQuality">
                        <Image.RenderTransform>
                            <ScaleTransform ScaleX="1" ScaleY="1" />
                        </Image.RenderTransform>
                        <Image.Triggers>
                            <EventTrigger RoutedEvent="Loaded">
                                <BeginStoryboard>
                                    <Storyboard RepeatBehavior="Forever" AutoReverse="True">
                                        <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)"
                                                         From="0.92" To="1" Duration="0:0:0.9">
                                            <DoubleAnimation.EasingFunction>
                                                <SineEase EasingMode="EaseInOut" />
                                            </DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                        <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)"
                                                         From="0.92" To="1" Duration="0:0:0.9">
                                            <DoubleAnimation.EasingFunction>
                                                <SineEase EasingMode="EaseInOut" />
                                            </DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                    </Storyboard>
                                </BeginStoryboard>
                            </EventTrigger>
                        </Image.Triggers>
                    </Image>
                </Grid>
                <TextBlock x:Name="LoadingTitle" Text="正在启动 FlyknitBuddy…" FontSize="17" FontWeight="SemiBold"
                           Foreground="#1F2330" HorizontalAlignment="Center" FontFamily="Microsoft YaHei UI, Segoe UI" />
                <TextBlock x:Name="LoadingSubtitle" Text="准备就绪后将自动打开工作区。" FontSize="13" Margin="0,8,0,0"
                           Foreground="#7A8092" HorizontalAlignment="Center" FontFamily="Microsoft YaHei UI, Segoe UI" />
            </StackPanel>
        </Border>
        <wv2:WebView2 x:Name="Web" Visibility="Hidden" />
        <StackPanel x:Name="ErrorPanel"
                    Visibility="Collapsed"
                    Margin="32"
                    VerticalAlignment="Center"
                    HorizontalAlignment="Center">
            <TextBlock x:Name="ErrorText"
                       TextWrapping="Wrap"
                       FontSize="15"
                       Foreground="#C4362D"
                       HorizontalAlignment="Center" />
            <!-- 不用再去托盘里找「退出」再手动打开 -->
            <Button x:Name="RestartButton"
                    Margin="0,18,0,0"
                    Padding="18,7"
                    HorizontalAlignment="Center"
                    Cursor="Hand"
                    Click="OnRestartClick" />
        </StackPanel>
    </Grid>
</Window>
