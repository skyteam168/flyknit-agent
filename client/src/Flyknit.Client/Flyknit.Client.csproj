<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.17763.0</SupportedOSPlatformVersion>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <!-- WPF 与 WinForms 同时启用时关闭隐式 using，避免 Application 等类型重名 -->
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <RootNamespace>Flyknit.Client</RootNamespace>
    <AssemblyName>FlyknitBuddy</AssemblyName>
    <ApplicationIcon>Assets\flyknitbuddy.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Version>0.1.0</Version>
    <Product>FlyknitBuddy</Product>
    <AssemblyTitle>FlyknitBuddy 智能办公助手</AssemblyTitle>
    <Company>Flyknit</Company>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.2903.40" />
    <!-- Windows 系统通知（带按钮的 Toast，未打包的桌面程序也可使用） -->
    <PackageReference Include="Microsoft.Toolkit.Uwp.Notifications" Version="7.1.3" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Flyknit.Core\Flyknit.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Assets\flyknitbuddy.png" />
    <Content Include="Assets\flyknitbuddy.ico" CopyToOutputDirectory="PreserveNewest" />
    <!-- 系统通知里显示的图标需要是磁盘上的文件 -->
    <Content Include="Assets\flyknitbuddy-toast.png" CopyToOutputDirectory="PreserveNewest" />
    <!-- 聊天界面：先在 client/web 执行 npm run build -->
    <Content Include="wwwroot\**\*" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <Target Name="CheckWebBuild" BeforeTargets="Build" Condition="!Exists('wwwroot\index.html')">
    <Warning Text="未找到 wwwroot\index.html，请先在 client\web 目录执行 npm install 和 npm run build。" />
  </Target>

</Project>
