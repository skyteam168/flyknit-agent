{
  "version": 1,
  "auto_run_readonly": true,
  "no_delete_roots": [
    "C:\\",
    "D:\\",
    "C:\\Users",
    "C:\\Windows",
    "C:\\Program Files",
    "C:\\Program Files (x86)",
    "C:\\ProgramData"
  ],
  "recursive_delete_patterns": [
    "\\brm\\s+(-[a-z]*r[a-z]*f|-[a-z]*f[a-z]*r)\\b",
    "\\brm\\s+-(-recursive|-force)",
    "\\bremove-item\\b(?=.*-r(ecurse)?\\b)(?=.*-fo(rce)?\\b)",
    "\\b(rd|rmdir)\\s+/s\\b",
    "\\bdel\\s+(/[a-z]\\s+)*/s\\b",
    "\\berase\\s+(/[a-z]\\s+)*/s\\b"
  ],
  "blocked_patterns": [
    "\\bformat(\\.com)?\\s+[a-z]:",
    "\\bformat-volume\\b",
    "\\bclear-disk\\b",
    "\\bdiskpart\\b",
    "\\bbcdedit\\b",
    "\\bbootrec\\b",
    "\\bvssadmin\\s+delete\\b",
    "\\bwbadmin\\s+delete\\b",
    "\\bcipher\\s+/w\\b",
    "\\breg\\s+(delete|add|import)\\s+\\\"?hk(lm|ey_local_machine)",
    "\\bremove-item\\b.*\\bhklm:",
    "\\bset-itemproperty\\b.*\\bhklm:",
    "\\bsc(\\.exe)?\\s+(delete|config)\\b",
    "\\b(stop|remove|set)-service\\b",
    "\\bschtasks\\b.*\\b/delete\\b.*\\b/tn\\s+\\\"?\\\\microsoft",
    "\\bset-mppreference\\b",
    "\\bnetsh\\s+(adv)?firewall\\b.*\\b(off|disable)",
    "\\bset-netfirewallprofile\\b.*-enabled\\s+false",
    "\\bnet\\s+(user|localgroup)\\b.*(/add|/delete|/active)",
    "\\bnet\\s+user\\s+\\S+\\s+\\S+",
    "\\b(new|remove|set)-localuser\\b",
    "\\b(add|remove)-localgroupmember\\b",
    "\\btakeown\\b.*\\b(c:\\\\windows|c:\\\\program files)",
    "\\bicacls\\b.*\\b(c:\\\\windows|c:\\\\program files)",
    "\\bshutdown(\\.exe)?\\s+(/|-)[srpf]\\b",
    "\\b(stop|restart)-computer\\b",
    "\\b(iwr|invoke-webrequest|curl|wget)\\b.*\\|\\s*(iex|invoke-expression)\\b",
    "\\biex\\s*\\(\\s*(new-object\\s+net\\.webclient|iwr|invoke-webrequest)",
    "\\bpowershell(\\.exe)?\\b.*\\s-e(nc|ncodedcommand)?\\s+[a-z0-9+/=]{20,}",
    "\\b(del|erase|remove-item|rm|move|move-item)\\b.*\\bc:\\\\windows\\b",
    "\\b(del|erase|remove-item|rm)\\b\\s+(\\\"?[a-z]:\\\\\\\"?)(\\s|$)"
  ],
  "readonly_commands": [
    "ipconfig",
    "ping",
    "tracert",
    "nslookup",
    "hostname",
    "whoami",
    "systeminfo",
    "dir",
    "tree",
    "tasklist",
    "get-process",
    "get-childitem",
    "get-content",
    "get-date",
    "get-location",
    "get-netipaddress",
    "get-computerinfo",
    "test-connection",
    "get-volume",
    "get-psdrive"
  ],
  "writable_roots": [
    "%USERPROFILE%",
    "D:\\",
    "E:\\"
  ],
  "protected_roots": [
    "C:\\Windows",
    "C:\\Program Files",
    "C:\\Program Files (x86)",
    "C:\\ProgramData"
  ],
  "batch_confirm_threshold": 20
}
