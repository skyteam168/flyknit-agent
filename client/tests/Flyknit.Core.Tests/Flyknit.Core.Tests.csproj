<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.11.1" />
    <PackageReference Include="xunit" Version="2.9.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2" />
  </ItemGroup>

  <ItemGroup>
    <!-- 仿照真实记忆文件写的样例（内容虚构），用来检验导入去重、整理和检索效果 -->
    <None Update="Fixtures\**" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <!-- 安装程序里不碰 Windows 的那几块逻辑（安装包格式、代理配置），直接拿源文件来测 -->
    <Compile Include="..\..\src\Flyknit.Setup\Payload.cs" Link="Setup\Payload.cs" />
    <Compile Include="..\..\src\Flyknit.Setup\AgentSettings.cs" Link="Setup\AgentSettings.cs" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Flyknit.Core\Flyknit.Core.csproj" />
  </ItemGroup>

</Project>
