# 管理后台令牌：调用 /api/v1/admin/* 时放在 Authorization: Bearer 中
FLYKNIT_ADMIN_TOKEN=change-me-admin-token

# 用于加密模型 Key、SMB 密码等敏感配置。务必改成随机长字符串，且部署后不要再改
FLYKNIT_SECRET_KEY=change-me-to-a-long-random-string

# 客户端注册密钥：新电脑首次注册时需要填写
FLYKNIT_ENROLLMENT_KEY=flyknit-enroll

# 数据库：默认 SQLite；生产建议 PostgreSQL
# FLYKNIT_DATABASE_URL=postgresql+asyncpg://flyknit:password@db:5432/flyknit
FLYKNIT_DATABASE_URL=sqlite+aiosqlite:///./flyknit.db

# 上游模型请求超时（秒）
FLYKNIT_UPSTREAM_TIMEOUT=300
