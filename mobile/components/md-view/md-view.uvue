<template>
	<view class="md">
		<view v-for="(b, bi) in blocks" :key="bi" class="md-block">
			<text v-if="b.kind == 'heading'" class="md-heading" :style="headingStyle(b.level)" :selectable="true">
				<text v-for="(s, si) in b.spans" :key="si" :style="spanStyle(s, c.ink)">{{ s.text }}</text>
			</text>

			<text v-else-if="b.kind == 'para'" class="md-para" :style="bodyStyle(c.ink)" :selectable="true">
				<text v-for="(s, si) in b.spans" :key="si" :style="spanStyle(s, c.ink)">{{ s.text }}</text>
			</text>

			<view v-else-if="b.kind == 'bullet' || b.kind == 'ordered'" class="md-item" :style="{ paddingLeft: (b.level * 16).toString() + 'px' }">
				<text class="md-mark" :style="{ color: b.label == 'done' ? c.thread : c.inkSoft, fontSize: bodySize, lineHeight: bodyLine }">{{ markOf(b) }}</text>
				<text class="md-item-text" :style="bodyStyle(b.label == 'done' ? c.inkFaint : c.ink)" :selectable="true">
					<text v-for="(s, si) in b.spans" :key="si" :style="spanStyle(s, b.label == 'done' ? c.inkFaint : c.ink)">{{ s.text }}</text>
				</text>
			</view>

			<view v-else-if="b.kind == 'quote'" class="md-quote" :style="{ borderLeftColor: c.lineStrong }">
				<text class="md-para" :style="bodyStyle(c.inkSoft)" :selectable="true">
					<text v-for="(s, si) in b.spans" :key="si" :style="spanStyle(s, c.inkSoft)">{{ s.text }}</text>
				</text>
			</view>

			<!-- 模型常把 ECharts 写成 ```javascript option = {...} -->
			<md-inline-visual
				v-else-if="b.kind == 'code' && looksLikeEcharts(b.text)"
				lang="echarts"
				:code="stripFence(b.text)"
				:title="chartTitle"
				:ready="richReady"
				:height="320"
			></md-inline-visual>

			<view v-else-if="b.kind == 'code'" class="md-code" :style="{ backgroundColor: c.codeBg, borderColor: c.line }">
				<view class="md-code-head">
					<text class="md-code-lang" :style="{ color: c.inkFaint }">{{ b.label != '' ? b.label : 'code' }}</text>
					<text class="md-code-copy" :style="{ color: c.indigo }" @click="copy(b.text)">{{ copyLabel }}</text>
				</view>
				<scroll-view direction="horizontal" class="md-code-scroll">
					<view class="md-code-body">
						<text
							v-for="(line, li) in codeLines(b)"
							:key="li"
							class="md-code-line"
							:style="{ fontSize: codeSize, lineHeight: bodyLine }"
							:selectable="true"
						>
							<text v-for="(tok, ti) in line" :key="ti" :style="{ color: tokColor(tok.kind) }">{{ tok.text }}</text>
							<text v-if="line.length == 0" :style="{ color: tokColor('plain') }"> </text>
						</text>
					</view>
				</scroll-view>
			</view>

			<scroll-view v-else-if="b.kind == 'table'" direction="horizontal" class="md-table-scroll">
				<view class="md-table" :style="{ borderColor: c.line }">
					<view v-for="(row, ri) in b.rows" :key="ri" class="md-tr" :style="{ backgroundColor: ri == 0 ? c.sunk : c.cloth, borderBottomColor: c.line }">
						<view v-for="(cell, ci) in row" :key="ci" class="md-td" :style="{ borderRightColor: c.line }">
							<text class="md-td-text" :style="{ color: c.ink, fontWeight: ri == 0 ? 'bold' : 'normal', fontSize: tableSize }" :selectable="true">
								<text v-for="(s, si) in cellSpans(cell)" :key="si" :style="spanStyle(s, c.ink)">{{ s.text }}</text>
							</text>
						</view>
					</view>
				</view>
			</scroll-view>

			<view v-else-if="b.kind == 'rule'" class="md-rule" :style="{ backgroundColor: c.line }"></view>

			<!-- flyknit-chart：流式中占位，结束后原生绘制 -->
			<view v-else-if="b.kind == 'visual' && isChart(b.label) && !richReady" class="md-loading" :style="{ backgroundColor: c.sunk, borderColor: c.line }">
				<view class="md-loading-dot" :style="{ backgroundColor: c.indigo }"></view>
				<text class="md-loading-t" :style="{ color: c.inkSoft }">{{ chartLoading }}</text>
			</view>
			<md-chart v-else-if="b.kind == 'visual' && isChart(b.label)" :code="b.text"></md-chart>
			<!-- Mermaid / ECharts：流式结束后对话内嵌渲染 -->
			<md-inline-visual
				v-else-if="b.kind == 'visual' && isRichVisual(b.label)"
				:lang="b.label"
				:code="b.text"
				:title="visualTitle(b.label)"
				:ready="richReady"
				:height="isFlow(b.label) ? 260 : 320"
			></md-inline-visual>
			<view v-else-if="b.kind == 'visual'" class="md-visual" :style="{ backgroundColor: c.indigoWash }" @click="copy(b.text)">
				<text class="md-visual-title" :style="{ color: c.indigo }">{{ visualTitle(b.label) }}</text>
				<text class="md-visual-hint" :style="{ color: c.inkSoft }">{{ visualHint }}</text>
			</view>
		</view>
	</view>
</template>

<script setup lang="uts">
	import { computed } from 'vue'
	import { MdBlock, MdSpan, parseInline, parseMarkdown } from '../../common/markdown.uts'
	import { HlTok, highlightLines, tokColor as hlColor } from '../../common/highlight.uts'
	import { bodyFontPx, bodyLinePx, headingFontPx } from '../../common/prefs.uts'
	import { Palette, theme } from '../../common/theme.uts'
	import { t } from '../../common/i18n.uts'

	const props = defineProps({
		content: { type: String, default: '' },
		/** 父级流式 bump；确保 blocks 跟着重算 */
		contentRev: { type: Number, default: 0 },
		/** 父级传入字号档，切换后强制刷新 */
		fontSize: { type: String, default: 'medium' },
		/** 流式结束后再渲染图表/流程图（避免边输出边反复建 web-view） */
		richReady: { type: Boolean, default: true }
	})

	const c = computed<Palette>(() : Palette => theme.c)
	const richReady = computed(() : boolean => props.richReady)
	// 组件模板不能直接调用 import 的 t()（UTS→Kotlin 报 invoke）
	const copyLabel = computed(() : string => t('chat.copy'))
	const chartTitle = computed(() : string => t('chat.mdChart'))
	const chartLoading = computed(() : string => t('chat.mdChartLoading'))
	const visualHint = computed(() : string => t('chat.mdVisualHint'))
	const blocks = computed(() : Array<MdBlock> => {
		const _rev = props.contentRev
		const _font = props.fontSize
		const _ready = props.richReady
		return parseMarkdown(props.content)
	})
	const bodySize = computed(() : string => {
		const _dep = props.fontSize
		return bodyFontPx().toString() + 'px'
	})
	const bodyLine = computed(() : string => {
		const _dep = props.fontSize
		return bodyLinePx().toString() + 'px'
	})
	const codeSize = computed(() : string => {
		const _dep = props.fontSize
		return Math.max(12, bodyFontPx() - 2).toString() + 'px'
	})
	const tableSize = computed(() : string => {
		const _dep = props.fontSize
		return Math.max(12, bodyFontPx() - 2).toString() + 'px'
	})

	function headingStyle(level : number) : UTSJSONObject {
		const _dep = props.fontSize
		const px = headingFontPx(level)
		return {
			color: theme.c.ink,
			fontSize: px.toString() + 'px',
			lineHeight: Math.round(px * 1.4).toString() + 'px'
		} as UTSJSONObject
	}

	function bodyStyle(color : string) : UTSJSONObject {
		return {
			color: color,
			fontSize: bodySize.value,
			lineHeight: bodyLine.value
		} as UTSJSONObject
	}

	function spanStyle(s : MdSpan, color : string) : UTSJSONObject {
		const st = { color: color } as UTSJSONObject
		if (s.bold) {
			st['fontWeight'] = 'bold'
		}
		if (s.italic) {
			st['fontStyle'] = 'italic'
		}
		if (s.code) {
			st['backgroundColor'] = theme.c.chip
			st['fontFamily'] = 'monospace'
		}
		return st
	}

	function markOf(b : MdBlock) : string {
		if (b.kind == 'ordered') return b.label + '.'
		if (b.label == 'done') return '☑'
		if (b.label == 'todo') return '☐'
		return '•'
	}

	function isChart(lang : string) : boolean {
		return lang == 'chart' || lang == 'flyknit-chart'
	}

	function isRichVisual(lang : string) : boolean {
		return lang == 'mermaid' || lang == 'mmd' || lang == 'echarts'
	}

	function isFlow(lang : string) : boolean {
		return lang == 'mermaid' || lang == 'mmd'
	}

	function looksLikeEcharts(text : string) : boolean {
		const s = text.trim()
		if (s.length < 40) return false
		const hasOption = s.indexOf('option') >= 0 || s.indexOf('xAxis') >= 0 || s.indexOf('yAxis') >= 0
		const hasSeries = s.indexOf('series') >= 0
		return hasOption && hasSeries
	}

	function visualTitle(lang : string) : string {
		if (lang == 'mermaid' || lang == 'mmd' || lang == 'dot' || lang == 'graphviz' || lang == 'gv') return t('chat.mdFlow')
		if (lang == 'ui' || lang == 'flyknit-ui') return t('chat.mdCard')
		return t('chat.mdChart')
	}

	function stripFence(src : string) : string {
		let s = src.trim()
		if (s.startsWith('```')) {
			const nl = s.indexOf('\n')
			if (nl > 0) s = s.substring(nl + 1)
		}
		if (s.endsWith('```')) {
			s = s.substring(0, s.length - 3).trim()
		}
		return s
	}

	function openVisual(lang : string, raw : string) {
		const code = stripFence(raw)
		const payload = {
			lang: lang,
			code: code,
			title: visualTitle(lang)
		} as UTSJSONObject
		uni.setStorageSync('fk_visual_payload', JSON.stringify(payload))
		uni.navigateTo({ url: '/pages/visual/visual' })
	}

	function codeLines(b : MdBlock) : Array<Array<HlTok>> {
		return highlightLines(b.text, b.label)
	}

	function tokColor(kind : string) : string {
		return hlColor(kind, theme.dark)
	}

	function cellSpans(cell : string) : Array<MdSpan> {
		return parseInline(cell)
	}

	function copy(text : string) {
		if (text == '') return
		uni.setClipboardData({ data: text })
	}
</script>

<style>
	.md {
		flex-direction: column;
	}
	.md-block {
		margin-bottom: 8px;
	}
	.md-heading {
		font-weight: bold;
		margin-top: 4px;
	}
	.md-para {
	}
	.md-item {
		flex-direction: row;
		align-items: flex-start;
	}
	.md-mark {
		width: 22px;
	}
	.md-item-text {
		flex: 1;
	}
	.md-quote {
		border-left-width: 3px;
		border-left-style: solid;
		padding-left: 10px;
	}
	.md-code {
		border-width: 1px;
		border-style: solid;
		border-radius: 10px;
		padding: 8px 10px;
	}
	.md-code-head {
		flex-direction: row;
		justify-content: space-between;
		margin-bottom: 4px;
	}
	.md-code-lang {
		font-size: 12px;
	}
	.md-code-copy {
		font-size: 12px;
	}
	.md-code-scroll {
		flex-direction: row;
	}
	.md-code-body {
		flex-direction: column;
	}
	.md-code-line {
		font-family: monospace;
		white-space: pre;
	}
	.md-table-scroll {
		flex-direction: row;
	}
	.md-table {
		border-width: 1px;
		border-style: solid;
		border-radius: 8px;
		overflow: hidden;
	}
	.md-tr {
		flex-direction: row;
		border-bottom-width: 1px;
		border-bottom-style: solid;
	}
	.md-td {
		min-width: 88px;
		max-width: 200px;
		padding: 6px 8px;
		border-right-width: 1px;
		border-right-style: solid;
		flex-direction: column;
	}
	.md-td-text {
		line-height: 19px;
	}
	.md-rule {
		height: 1px;
		margin: 6px 0;
	}
	.md-visual {
		border-radius: 10px;
		padding: 10px 12px;
	}
	.md-visual-title {
		font-size: 14px;
		font-weight: bold;
	}
	.md-visual-hint {
		font-size: 12px;
		margin-top: 2px;
	}
	.md-loading {
		height: 200px;
		border-width: 1px;
		border-style: solid;
		border-radius: 10px;
		flex-direction: row;
		align-items: center;
		justify-content: center;
	}
	.md-loading-dot {
		width: 8px;
		height: 8px;
		border-radius: 4px;
		margin-right: 8px;
	}
	.md-loading-t {
		font-size: 13px;
	}
</style>
