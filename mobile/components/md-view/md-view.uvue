<template>
	<view class="md">
		<view v-for="(b, bi) in blocks" :key="bi" class="md-block">
			<text v-if="b.kind == 'heading'" class="md-heading" :style="headingStyle(b.level)" :selectable="true">
				<text v-for="(s, si) in b.spans" :key="si" :style="spanStyle(s)">{{ s.text }}</text>
			</text>

			<text v-else-if="b.kind == 'para'" class="md-para" :style="bodyStyle(c.ink)" :selectable="true">
				<text v-for="(s, si) in b.spans" :key="si" :style="spanStyle(s)">{{ s.text }}</text>
			</text>

			<view v-else-if="b.kind == 'bullet' || b.kind == 'ordered'" class="md-item" :style="{ paddingLeft: (b.level * 16).toString() + 'px' }">
				<text class="md-mark" :style="{ color: b.label == 'done' ? c.thread : c.inkSoft, fontSize: bodySize, lineHeight: bodyLine }">{{ markOf(b) }}</text>
				<text class="md-item-text" :style="bodyStyle(b.label == 'done' ? c.inkFaint : c.ink)" :selectable="true">
					<text v-for="(s, si) in b.spans" :key="si" :style="spanStyle(s)">{{ s.text }}</text>
				</text>
			</view>

			<view v-else-if="b.kind == 'quote'" class="md-quote" :style="{ borderLeftColor: c.lineStrong }">
				<text class="md-para" :style="bodyStyle(c.inkSoft)" :selectable="true">
					<text v-for="(s, si) in b.spans" :key="si" :style="spanStyle(s)">{{ s.text }}</text>
				</text>
			</view>

			<view v-else-if="b.kind == 'code'" class="md-code" :style="{ backgroundColor: c.codeBg, borderColor: c.line }">
				<view class="md-code-head">
					<text class="md-code-lang" :style="{ color: c.inkFaint }">{{ b.label != '' ? b.label : 'code' }}</text>
					<text class="md-code-copy" :style="{ color: c.indigo }" @click="copy(b.text)">复制</text>
				</view>
				<scroll-view direction="horizontal" class="md-code-scroll">
					<text class="md-code-text" :style="{ color: c.ink, fontSize: codeSize, lineHeight: bodyLine }" :selectable="true">{{ b.text }}</text>
				</scroll-view>
			</view>

			<scroll-view v-else-if="b.kind == 'table'" direction="horizontal" class="md-table-scroll">
				<view class="md-table" :style="{ borderColor: c.line }">
					<view v-for="(row, ri) in b.rows" :key="ri" class="md-tr" :style="{ backgroundColor: ri == 0 ? c.sunk : c.cloth, borderBottomColor: c.line }">
						<text v-for="(cell, ci) in row" :key="ci" class="md-td" :style="{ color: c.ink, fontWeight: ri == 0 ? 'bold' : 'normal', borderRightColor: c.line, fontSize: tableSize }">{{ cell }}</text>
					</view>
				</view>
			</scroll-view>

			<view v-else-if="b.kind == 'rule'" class="md-rule" :style="{ backgroundColor: c.line }"></view>

			<view v-else-if="b.kind == 'visual'" class="md-visual" :style="{ backgroundColor: c.indigoWash }">
				<text class="md-visual-title" :style="{ color: c.indigo }">{{ visualTitle(b.label) }}</text>
				<text class="md-visual-hint" :style="{ color: c.inkSoft }">这部分在电脑上的 FlyknitBuddy 里显示效果更好</text>
			</view>
		</view>
	</view>
</template>

<script setup lang="uts">
	import { computed } from 'vue'
	import { MdBlock, MdSpan, parseMarkdown } from '../../common/markdown.uts'
	import { bodyFontPx, bodyLinePx, headingFontPx } from '../../common/prefs.uts'
	import { theme } from '../../common/theme.uts'

	const props = defineProps({
		content: { type: String, default: '' },
		/** 父级流式 bump；确保 blocks 跟着重算 */
		contentRev: { type: Number, default: 0 },
		/** 父级传入字号档，切换后强制刷新 */
		fontSize: { type: String, default: 'medium' }
	})

	const c = computed(() => theme.c)
	const blocks = computed(() : Array<MdBlock> => {
		const _ = props.contentRev
		const __ = props.fontSize
		return parseMarkdown(props.content)
	})
	const bodySize = computed(() : string => {
		const _ = props.fontSize
		return bodyFontPx().toString() + 'px'
	})
	const bodyLine = computed(() : string => {
		const _ = props.fontSize
		return bodyLinePx().toString() + 'px'
	})
	const codeSize = computed(() : string => {
		const _ = props.fontSize
		return Math.max(12, bodyFontPx() - 2).toString() + 'px'
	})
	const tableSize = computed(() : string => {
		const _ = props.fontSize
		return Math.max(12, bodyFontPx() - 2).toString() + 'px'
	})

	function headingStyle(level : number) : UTSJSONObject {
		const _ = props.fontSize
		const px = headingFontPx(level)
		return {
			color: theme.c.ink,
			fontSize: px.toString() + 'px',
			lineHeight: Math.round(px * 1.4).toString() + 'px'
		} as UTSJSONObject
	}

	function bodyStyle(color : string) : UTSJSONObject {
		return {
			color: color,
			fontSize: bodySize.value,
			lineHeight: bodyLine.value
		} as UTSJSONObject
	}

	function spanStyle(s : MdSpan) : UTSJSONObject {
		const st = {} as UTSJSONObject
		if (s.bold) {
			st['fontWeight'] = 'bold'
		}
		if (s.italic) {
			st['fontStyle'] = 'italic'
		}
		if (s.code) {
			st['backgroundColor'] = theme.c.chip
			st['fontFamily'] = 'monospace'
		}
		return st
	}

	function markOf(b : MdBlock) : string {
		if (b.kind == 'ordered') return b.label + '.'
		if (b.label == 'done') return '☑'
		if (b.label == 'todo') return '☐'
		return '•'
	}

	function visualTitle(lang : string) : string {
		if (lang == 'mermaid' || lang == 'mmd' || lang == 'dot' || lang == 'graphviz' || lang == 'gv') return '流程图'
		if (lang == 'ui' || lang == 'flyknit-ui') return '卡片'
		return '图表'
	}

	function copy(text : string) {
		uni.setClipboardData({ data: text })
	}
</script>

<style>
	.md {
		flex-direction: column;
	}
	.md-block {
		margin-bottom: 8px;
	}
	.md-heading {
		font-weight: bold;
		margin-top: 4px;
	}
	.md-para {
	}
	.md-item {
		flex-direction: row;
		align-items: flex-start;
	}
	.md-mark {
		width: 22px;
	}
	.md-item-text {
		flex: 1;
	}
	.md-quote {
		border-left-width: 3px;
		border-left-style: solid;
		padding-left: 10px;
	}
	.md-code {
		border-width: 1px;
		border-style: solid;
		border-radius: 10px;
		padding: 8px 10px;
	}
	.md-code-head {
		flex-direction: row;
		justify-content: space-between;
		margin-bottom: 4px;
	}
	.md-code-lang {
		font-size: 12px;
	}
	.md-code-copy {
		font-size: 12px;
	}
	.md-code-scroll {
		flex-direction: row;
	}
	.md-code-text {
		font-family: monospace;
		font-size: 13px;
		line-height: 20px;
	}
	.md-table-scroll {
		flex-direction: row;
	}
	.md-table {
		border-width: 1px;
		border-style: solid;
		border-radius: 8px;
		overflow: hidden;
	}
	.md-tr {
		flex-direction: row;
		border-bottom-width: 1px;
		border-bottom-style: solid;
	}
	.md-td {
		width: 120px;
		padding: 6px 8px;
		font-size: 13px;
		line-height: 19px;
		border-right-width: 1px;
		border-right-style: solid;
	}
	.md-rule {
		height: 1px;
		margin: 6px 0;
	}
	.md-visual {
		border-radius: 10px;
		padding: 10px 12px;
	}
	.md-visual-title {
		font-size: 14px;
		font-weight: bold;
	}
	.md-visual-hint {
		font-size: 12px;
		margin-top: 2px;
	}
</style>
