<template>
	<view class="wrap" :style="{ height: boxH, backgroundColor: c.sunk, borderColor: c.line }">
		<!-- 流式未结束：占位，避免边收字边反复建 web-view -->
		<view v-if="!ready" class="ph">
			<view class="pulse" :style="{ backgroundColor: c.indigo }"></view>
			<text class="ph-t" :style="{ color: c.inkSoft }">{{ loadingText }}</text>
		</view>
		<!-- 结束后再挂载；用 :key 保证每条消息独立 -->
		<web-view
			v-else
			:id="vid"
			class="wv"
			:src="pageSrc"
			:fullscreen="false"
			:horizontal-scroll-bar-access="false"
			:vertical-scroll-bar-access="false"
			android-nested-scroll="none"
			@load="onWebLoad"
			@error="onWebError"
		></web-view>
		<text v-if="ready" class="full" :style="{ color: c.indigo }" @click="openFull">{{ fullLabel }}</text>
	</view>
</template>

<script setup lang="uts">
	import { computed, getCurrentInstance, ref, watch } from 'vue'
	import { Palette, theme } from '../../common/theme.uts'
	import { t } from '../../common/i18n.uts'

	const props = defineProps({
		lang: { type: String, default: '' },
		code: { type: String, default: '' },
		title: { type: String, default: '' },
		/** 流式结束后再 true */
		ready: { type: Boolean, default: false },
		/** 固定高度 */
		height: { type: Number, default: 280 }
	})

	const c = computed<Palette>(() : Palette => theme.c)
	const instance = getCurrentInstance()
	const failed = ref(false)
	const tick = ref(0)
	let seq = Date.now()
	const vid = 'mdiv_' + (seq++).toString()

	const boxH = computed(() : string => props.height.toString() + 'px')
	// 组件模板不能直接调用 import 的函数（UTS→Kotlin 会报 invoke）
	const fullLabel = computed(() : string => t('chat.mdVisualFull'))
	const loadingText = computed(() : string => {
		if (props.lang == 'mermaid' || props.lang == 'mmd') return t('chat.mdFlowLoading')
		return t('chat.mdChartLoading')
	})

	function buildPayloadJson() : string {
		const payload = {
			lang: props.lang,
			code: props.code,
			theme: theme.dark ? 'dark' : 'light'
		} as UTSJSONObject
		return JSON.stringify(payload)
	}

	const pageSrc = computed(() : string => {
		if (!props.ready || props.code == '') {
			return ''
		}
		const base = '/hybrid/html/visual.html?embed=1&t=' + tick.value.toString()
		// #ifdef WEB
		return base + '&p=' + encodeURIComponent(buildPayloadJson())
		// #endif
		// #ifndef WEB
		if (props.code.length < 1800) {
			return base + '&p=' + encodeURIComponent(buildPayloadJson())
		}
		return base
		// #endif
	})

	function pushByContext() {
		// #ifdef APP-ANDROID || APP-IOS || APP-HARMONY
		if (!props.ready || props.code == '') return
		try {
			const proxy = instance?.proxy
			const ctx = proxy != null ? uni.createWebViewContext(vid, proxy) : null
			if (ctx == null) return
			const encoded = encodeURIComponent(buildPayloadJson())
			const js = '(function tryPaint(n){if(window.renderBlock){window.renderBlock(JSON.parse(decodeURIComponent("' +
				encoded +
				'")));return;}if(n<30){setTimeout(function(){tryPaint(n+1)},100)}})(0)'
			ctx.evalJS(js)
			failed.value = false
		} catch (e) {
			failed.value = true
			console.error(e)
		}
		// #endif
	}

	function onWebLoad(_ev : UniWebViewLoadEvent) {
		// #ifdef APP-ANDROID || APP-IOS || APP-HARMONY
		setTimeout(() => { pushByContext() }, 200)
		// #endif
	}

	function onWebError(_ev : UniWebViewErrorEvent) {
		failed.value = true
	}

	function openFull() {
		const payload = {
			lang: props.lang,
			code: props.code,
			title: props.title != '' ? props.title : t('chat.mdChart')
		} as UTSJSONObject
		uni.setStorageSync('fk_visual_payload', JSON.stringify(payload))
		uni.navigateTo({ url: '/pages/visual/visual' })
	}

	watch([() : boolean => props.ready, () : string => props.code, () : boolean => theme.dark], () => {
		if (props.ready && props.code != '') {
			tick.value = Date.now()
		}
	})
</script>

<style>
	.wrap {
		position: relative;
		width: 100%;
		border-width: 1px;
		border-style: solid;
		border-radius: 10px;
		overflow: hidden;
	}
	.wv {
		width: 100%;
		height: 100%;
	}
	.ph {
		flex: 1;
		height: 100%;
		flex-direction: row;
		align-items: center;
		justify-content: center;
		padding: 12px;
	}
	.pulse {
		width: 8px;
		height: 8px;
		border-radius: 4px;
		margin-right: 8px;
	}
	.ph-t {
		font-size: 13px;
	}
	.full {
		position: absolute;
		right: 8px;
		top: 8px;
		font-size: 11px;
		padding: 2px 6px;
	}
</style>
