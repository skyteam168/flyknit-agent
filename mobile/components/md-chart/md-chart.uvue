<template>
	<view class="chart" :style="{ backgroundColor: c.sunk, borderColor: c.line }">
		<text v-if="chartTitle != ''" class="title" :style="{ color: c.ink }">{{ chartTitle }}</text>
		<text v-if="!hasSpec" class="err" :style="{ color: c.red }" @click="copy">{{ failText }}</text>

		<!-- 柱状 / 折线：竖柱 -->
		<view v-if="isBarLike" class="bars">
			<view v-for="(cat, i) in categories" :key="i" class="col">
				<view class="col-bars">
					<view
						v-for="(s, si) in seriesList"
						:key="si"
						class="bar"
						:style="{ height: barH(s.data, i), backgroundColor: colorAt(si), width: barW }"
					></view>
				</view>
				<text class="lab" :style="{ color: c.inkFaint }" :lines="1">{{ cat }}</text>
				<text class="val" :style="{ color: c.inkSoft }" :lines="1">{{ firstVal(i) }}</text>
			</view>
		</view>

		<!-- 条形图 -->
		<view v-else-if="isHbar" class="hbars">
			<view v-for="(cat, i) in categories" :key="i" class="hrow">
				<text class="hlab" :style="{ color: c.inkSoft }" :lines="1">{{ cat }}</text>
				<view class="htrack" :style="{ backgroundColor: c.chip }">
					<view class="hfill" :style="{ width: barPct(firstData, i), backgroundColor: colorAt(0) }"></view>
				</view>
				<text class="hval" :style="{ color: c.inkFaint }">{{ numAt(firstData, i) }}</text>
			</view>
		</view>

		<!-- 饼/环：列表 + 色块比例（原生无 canvas 扇区时的可读方案） -->
		<view v-else-if="isPie" class="pie">
			<view class="pie-track" :style="{ backgroundColor: c.chip }">
				<view
					v-for="(cat, i) in categories"
					:key="i"
					class="pie-seg"
					:style="{ width: piePct(i), backgroundColor: colorAt(i) }"
				></view>
			</view>
			<view v-for="(cat, i) in categories" :key="i" class="pie-row">
				<view class="dot" :style="{ backgroundColor: colorAt(i) }"></view>
				<text class="pie-name" :style="{ color: c.ink }" :lines="1">{{ cat }}</text>
				<text class="pie-val" :style="{ color: c.inkSoft }">{{ numAt(firstData, i) }}</text>
			</view>
		</view>

		<view v-else-if="hasSpec" class="hbars">
			<view v-for="(cat, i) in categories" :key="i" class="hrow">
				<text class="hlab" :style="{ color: c.inkSoft }" :lines="1">{{ cat }}</text>
				<view class="htrack" :style="{ backgroundColor: c.chip }">
					<view class="hfill" :style="{ width: barPct(firstData, i), backgroundColor: colorAt(0) }"></view>
				</view>
				<text class="hval" :style="{ color: c.inkFaint }">{{ numAt(firstData, i) }}</text>
			</view>
		</view>

		<view v-if="showLegend" class="legend">
			<view v-for="(s, si) in seriesList" :key="si" class="leg">
				<view class="dot" :style="{ backgroundColor: colorAt(si) }"></view>
				<text class="leg-t" :style="{ color: c.inkSoft }">{{ s.name != '' ? s.name : ('S' + (si + 1).toString()) }}</text>
			</view>
		</view>
	</view>
</template>

<script setup lang="uts">
	import { computed } from 'vue'
	import { CHART_COLORS, ChartSeries, ChartSpec, chartMax, parseChart } from '../../common/chart.uts'
	import { Palette, theme } from '../../common/theme.uts'
	import { t } from '../../common/i18n.uts'

	const props = defineProps({
		code: { type: String, default: '' }
	})

	const c = computed<Palette>(() : Palette => theme.c)
	// 模板不直接访问可空 ChartSpec?（Kotlin 不会因 v-if 收窄类型）
	const spec = computed(() : ChartSpec | null => parseChart(props.code))
	const hasSpec = computed(() : boolean => spec.value != null)
	const failText = computed(() : string => t('chat.mdVisualFail'))
	const chartTitle = computed(() : string => {
		const s = spec.value
		if (s == null) return ''
		return s.title
	})
	const chartType = computed(() : string => {
		const s = spec.value
		return s == null ? '' : s.type
	})
	const categories = computed(() : Array<string> => {
		const s = spec.value
		return s == null ? ([] as Array<string>) : s.categories
	})
	const seriesList = computed(() : Array<ChartSeries> => {
		const s = spec.value
		return s == null ? ([] as Array<ChartSeries>) : s.series
	})
	const firstData = computed(() : Array<number> => {
		const list = seriesList.value
		if (list.length == 0) return [] as Array<number>
		return list[0].data
	})
	const isBarLike = computed(() : boolean => {
		const ty = chartType.value
		return hasSpec.value && (ty == 'bar' || ty == 'line' || ty == 'area' || ty == 'scatter')
	})
	const isHbar = computed(() : boolean => hasSpec.value && chartType.value == 'hbar')
	const isPie = computed(() : boolean => {
		const ty = chartType.value
		return hasSpec.value && (ty == 'pie' || ty == 'donut')
	})
	const showLegend = computed(() : boolean => seriesList.value.length > 1)
	const maxV = computed(() : number => {
		const s = spec.value
		return s == null ? 1 : chartMax(s)
	})
	const barW = computed(() : string => {
		const n = seriesList.value.length
		if (n <= 1) return '18px'
		if (n == 2) return '12px'
		return '8px'
	})

	function colorAt(i : number) : string {
		return CHART_COLORS[i % CHART_COLORS.length]
	}

	function numAt(data : Array<number>, i : number) : string {
		if (i < 0 || i >= data.length) return '0'
		const n = data[i]
		if (Math.abs(n - Math.round(n)) < 0.05) return Math.round(n).toString()
		return (Math.round(n * 10) / 10).toString()
	}

	function firstVal(i : number) : string {
		return numAt(firstData.value, i)
	}

	function barH(data : Array<number>, i : number) : string {
		const v = (i >= 0 && i < data.length) ? data[i] : 0
		const px = Math.max(4, Math.round(v / maxV.value * 120))
		return px.toString() + 'px'
	}

	function barPct(data : Array<number>, i : number) : string {
		const v = (i >= 0 && i < data.length) ? data[i] : 0
		const pct = Math.max(2, Math.round(v / maxV.value * 100))
		return pct.toString() + '%'
	}

	function piePct(i : number) : string {
		const data = firstData.value
		if (data.length == 0) return '0%'
		let sum = 0
		data.forEach((n : number) => { sum += n })
		if (sum <= 0) return '0%'
		const v = (i >= 0 && i < data.length) ? data[i] : 0
		return Math.max(2, Math.round(v / sum * 100)).toString() + '%'
	}

	function copy() {
		if (props.code == '') return
		uni.setClipboardData({ data: props.code })
		uni.showToast({ title: t('chat.copied'), icon: 'none' })
	}
</script>

<style>
	.chart {
		border-width: 1px;
		border-style: solid;
		border-radius: 10px;
		padding: 10px 10px 8px 10px;
		flex-direction: column;
	}
	.title {
		font-size: 14px;
		font-weight: bold;
		margin-bottom: 8px;
	}
	.err {
		font-size: 12px;
	}
	.bars {
		flex-direction: row;
		align-items: flex-end;
		justify-content: space-between;
		min-height: 160px;
	}
	.col {
		flex: 1;
		flex-direction: column;
		align-items: center;
		padding: 0 2px;
	}
	.col-bars {
		flex-direction: row;
		align-items: flex-end;
		height: 120px;
	}
	.bar {
		border-radius: 4px 4px 0 0;
		margin-left: 1px;
		margin-right: 1px;
	}
	.lab {
		font-size: 11px;
		margin-top: 4px;
		max-width: 56px;
		text-align: center;
	}
	.val {
		font-size: 10px;
	}
	.hbars {
		flex-direction: column;
	}
	.hrow {
		flex-direction: row;
		align-items: center;
		margin-bottom: 8px;
	}
	.hlab {
		width: 52px;
		font-size: 12px;
	}
	.htrack {
		flex: 1;
		height: 14px;
		border-radius: 7px;
		overflow: hidden;
		margin: 0 8px;
	}
	.hfill {
		height: 14px;
		border-radius: 7px;
	}
	.hval {
		width: 40px;
		font-size: 11px;
		text-align: right;
	}
	.pie {
		flex-direction: column;
	}
	.pie-track {
		flex-direction: row;
		height: 14px;
		border-radius: 7px;
		overflow: hidden;
		margin-bottom: 10px;
	}
	.pie-seg {
		height: 14px;
	}
	.pie-row {
		flex-direction: row;
		align-items: center;
		margin-bottom: 6px;
	}
	.pie-name {
		flex: 1;
		font-size: 13px;
		margin-left: 8px;
	}
	.pie-val {
		font-size: 12px;
	}
	.dot {
		width: 8px;
		height: 8px;
		border-radius: 4px;
	}
	.legend {
		flex-direction: row;
		flex-wrap: wrap;
		margin-top: 8px;
	}
	.leg {
		flex-direction: row;
		align-items: center;
		margin-right: 12px;
		margin-bottom: 4px;
	}
	.leg-t {
		font-size: 11px;
		margin-left: 4px;
	}
</style>
