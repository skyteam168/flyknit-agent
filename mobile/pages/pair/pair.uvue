<template>
	<view class="page" :style="{ backgroundColor: c.loom, paddingTop: topInset.toString() + 'px' }">
		<scroll-view direction="vertical" class="body">
			<view class="hero">
				<image class="logo" src="/static/logo.png" mode="aspectFit"></image>
				<text class="title" :style="{ color: c.ink }">{{ t('pair.title') }}</text>
				<text class="sub" :style="{ color: c.inkSoft }">{{ t('pair.sub') }}</text>
			</view>

			<view class="card" :style="{ backgroundColor: c.sunk }">
				<view class="btn primary" :style="{ backgroundColor: c.action }" @click="scan">
					<text class="btn-text" :style="{ color: c.actionInk }">{{ t('pair.scan') }}</text>
				</view>
				<text class="hint" :style="{ color: c.inkFaint }">{{ t('pair.scanHint') }}</text>
				<input
					class="input"
					:style="{ backgroundColor: c.cloth, color: c.ink, borderColor: c.line }"
					:value="scanned"
					:placeholder="t('pair.scanPlaceholder')"
					:placeholder-style="'color:' + c.inkFaint"
					confirm-type="done"
					@input="onScannedInput"
					@confirm="onScannedConfirm"
				/>
			</view>

			<view class="manual-toggle" @click="manual = !manual">
				<text class="link" :style="{ color: c.indigo }">{{ manual ? t('pair.manualClose') : t('pair.manualOpen') }}</text>
			</view>

			<view v-if="manual" class="card" :style="{ backgroundColor: c.sunk }">
				<text class="label" :style="{ color: c.inkSoft }">{{ t('pair.server') }}</text>
				<input
					class="input"
					:style="{ backgroundColor: c.cloth, color: c.ink, borderColor: c.line }"
					:value="server"
					:placeholder="t('pair.serverPh')"
					:placeholder-style="'color:' + c.inkFaint"
					@input="onServer"
				/>
				<text class="label" :style="{ color: c.inkSoft }">{{ t('pair.code') }}</text>
				<input
					class="input code"
					:style="{ backgroundColor: c.cloth, color: c.ink, borderColor: c.line }"
					:value="code"
					:placeholder="t('pair.codePh')"
					:placeholder-style="'color:' + c.inkFaint"
					maxlength="16"
					@input="onCode"
				/>
				<view class="btn" :style="{ backgroundColor: c.cloth, borderColor: c.lineStrong }" @click="submitManual">
					<text class="btn-text" :style="{ color: c.ink }">{{ t('pair.bind') }}</text>
				</view>
			</view>

			<text v-if="error != ''" class="error" :style="{ color: c.red, backgroundColor: c.redWash }">{{ error }}</text>
			<text class="foot" :style="{ color: c.inkFaint }">{{ t('pair.foot') }}</text>
		</scroll-view>

		<view v-if="busy" class="busy" :style="{ backgroundColor: c.mask }">
			<view class="busy-card" :style="{ backgroundColor: c.cloth }">
				<text :style="{ color: c.ink }">{{ t('pair.binding') }}</text>
			</view>
		</view>
	</view>
</template>

<script setup lang="uts">
	import { computed, ref } from 'vue'
	import { Palette, theme } from '../../common/theme.uts'
	import { applyMe, state } from '../../common/store.uts'
	import { normalizeServer, pair, parsePairPayload } from '../../common/api.uts'
	import { connect } from '../../common/socket.uts'
	import { scanCode } from '../../common/scan.uts'
	import { refreshModels } from '../../common/prefs.uts'
	import { i18n, t, tf } from '../../common/i18n.uts'

	const c = computed<Palette>(() : Palette => theme.c)
	const topInset = uni.getWindowInfo().statusBarHeight + 24
	const scanned = ref('')
	const manual = ref(false)
	const server = ref('')
	const code = ref('')
	const error = ref('')
	const busy = ref(false)
	// 依赖语言，切换后重绘
	const _lang = computed(() : string => i18n.locale)

	async function doPair(srv : string, pairCode : string) {
		if (busy.value) {
			return
		}
		error.value = ''
		busy.value = true
		const res = await pair(srv, pairCode)
		busy.value = false
		if (!res.ok || res.data == null) {
			error.value = res.error
			return
		}
		const body = res.data as UTSJSONObject
		state.server = srv
		state.token = body.getString('token') ?? ''
		applyMe(body)
		connect()
		void refreshModels()
		uni.showToast({ title: tf('pair.bound', state.machineName), icon: 'none' })
		uni.reLaunch({ url: '/pages/chat/chat' })
	}

	function tryPayload(text : string) : boolean {
		const target = parsePairPayload(text)
		if (target == null) {
			return false
		}
		void doPair(target.server, target.code)
		return true
	}

	function scan() {
		scanCode((text : string) => {
			if (!tryPayload(text)) {
				error.value = t('pair.badQr')
			}
		}, (msg : string) => {
			error.value = msg
		})
	}

	function onScannedInput(e : UniInputEvent) {
		scanned.value = e.detail.value
		if (parsePairPayload(scanned.value) != null) {
			tryPayload(scanned.value)
		}
	}

	function onScannedConfirm(e : UniInputConfirmEvent) {
		if (!tryPayload(e.detail.value)) {
			error.value = t('pair.badQr')
		}
	}

	function onServer(e : UniInputEvent) {
		server.value = e.detail.value
	}

	function onCode(e : UniInputEvent) {
		code.value = e.detail.value.toUpperCase()
	}

	function submitManual() {
		const srv = normalizeServer(server.value)
		if (srv == '' || code.value.trim().length < 4) {
			error.value = t('pair.badQr')
			return
		}
		void doPair(srv, code.value.trim())
	}
</script>

<style>
	.page {
		flex: 1;
	}
	.body {
		flex: 1;
		padding: 0 20px 40px 20px;
	}
	.hero {
		align-items: center;
		padding: 24px 8px 20px 8px;
	}
	.logo {
		width: 72px;
		height: 72px;
		margin-bottom: 14px;
	}
	.title {
		font-size: 24px;
		font-weight: bold;
		margin-bottom: 8px;
		text-align: center;
	}
	.sub {
		font-size: 14px;
		line-height: 21px;
		text-align: center;
	}
	.card {
		border-radius: 16px;
		padding: 16px;
		margin-bottom: 12px;
	}
	.btn {
		height: 46px;
		border-radius: 12px;
		align-items: center;
		justify-content: center;
		border-width: 1px;
		border-style: solid;
		border-color: transparent;
		margin-top: 8px;
	}
	.primary {
		margin-top: 0;
		border-width: 0;
	}
	.btn-text {
		font-size: 16px;
		font-weight: bold;
	}
	.hint {
		font-size: 12px;
		margin: 12px 0 8px 0;
		line-height: 18px;
	}
	.input {
		height: 44px;
		border-radius: 10px;
		padding: 0 12px;
		border-width: 1px;
		border-style: solid;
		font-size: 15px;
		margin-bottom: 4px;
	}
	.code {
		letter-spacing: 2px;
	}
	.label {
		font-size: 13px;
		margin: 10px 0 6px 0;
	}
	.manual-toggle {
		align-items: center;
		padding: 8px;
	}
	.link {
		font-size: 14px;
	}
	.error {
		border-radius: 10px;
		padding: 10px 12px;
		font-size: 13px;
		line-height: 19px;
		margin-top: 8px;
	}
	.foot {
		font-size: 12px;
		line-height: 18px;
		text-align: center;
		margin-top: 20px;
		padding: 0 8px;
	}
	.busy {
		position: absolute;
		left: 0;
		top: 0;
		right: 0;
		bottom: 0;
		align-items: center;
		justify-content: center;
	}
	.busy-card {
		border-radius: 12px;
		padding: 16px 24px;
	}
</style>
