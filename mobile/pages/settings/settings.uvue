<template>
	<view class="page" :style="{ backgroundColor: c.sunk, paddingTop: topInset }">
		<view class="topbar">
			<view class="back" @click="back">
				<text class="back-text" :style="{ color: c.ink }">{{ t('common.back') }}</text>
			</view>
			<text class="title" :style="{ color: c.ink }">{{ t('settings.title') }}</text>
			<view class="back"></view>
		</view>
		<scroll-view direction="vertical" class="body">
			<text class="section" :style="{ color: c.inkFaint }">{{ t('settings.sectionDevice') }}</text>
			<view class="card" :style="{ backgroundColor: c.cloth }">
				<view class="row">
					<text class="key" :style="{ color: c.inkSoft }">{{ t('settings.machine') }}</text>
					<text class="val" :style="{ color: c.ink }">{{ machineName }}</text>
				</view>
				<view class="row" :style="{ borderTopColor: c.line }">
					<text class="key" :style="{ color: c.inkSoft }">{{ t('settings.user') }}</text>
					<text class="val" :style="{ color: c.ink }">{{ userName }}</text>
				</view>
				<view class="row" :style="{ borderTopColor: c.line }">
					<text class="key" :style="{ color: c.inkSoft }">{{ t('settings.status') }}</text>
					<text class="val" :style="{ color: online ? c.thread : c.inkFaint }">{{ online ? t('common.online') : t('common.offline') }}</text>
				</view>
				<view class="row" :style="{ borderTopColor: c.line }">
					<text class="key" :style="{ color: c.inkSoft }">{{ t('settings.server') }}</text>
					<text class="val" :style="{ color: c.ink }">{{ server }}</text>
				</view>
				<view class="row" :style="{ borderTopColor: c.line }">
					<text class="key" :style="{ color: c.inkSoft }">{{ t('settings.approvals') }}</text>
					<text class="val" :style="{ color: c.ink }">{{ approvals ? t('settings.approvalsOn') : t('settings.approvalsOff') }}</text>
				</view>
			</view>

			<text class="section" :style="{ color: c.inkFaint }">{{ t('settings.sectionModel') }}</text>
			<view class="card" :style="{ backgroundColor: c.cloth }">
				<view class="row-btn" @click="pickModel">
					<text class="key" :style="{ color: c.ink }">{{ t('settings.chatModel') }}</text>
					<text class="val" :style="{ color: c.inkFaint }">{{ modelName }}</text>
				</view>
				<view class="row" :style="{ borderTopColor: c.line }">
					<text class="key" :style="{ color: c.inkSoft }">{{ t('settings.deepThinking') }}</text>
					<switch class="sw" :checked="deepThinking" @change="onDeep" color="#3446c9" />
				</view>
				<view class="row" :style="{ borderTopColor: c.line }">
					<text class="key" :style="{ color: c.inkSoft }">{{ t('settings.webSearch') }}</text>
					<switch class="sw" :checked="webSearch" :disabled="!webSearchAvailable" @change="onWeb" color="#3446c9" />
				</view>
				<text class="hint" :style="{ color: c.inkFaint }">{{ t('settings.modelHint') }}</text>
			</view>

			<text class="section" :style="{ color: c.inkFaint }">{{ t('settings.sectionLang') }}</text>
			<view class="card" :style="{ backgroundColor: c.cloth }">
				<view class="seg" :style="{ backgroundColor: c.chip }">
					<view v-for="lang in LANG_OPTIONS" :key="lang.id" class="seg-item" :style="lang.id == locale ? { backgroundColor: c.cloth } : {}" @click="pickLang(lang.id)">
						<text class="seg-text" :style="{ color: lang.id == locale ? c.ink : c.inkSoft }">{{ lang.label }}</text>
					</view>
				</view>
			</view>

			<text class="section" :style="{ color: c.inkFaint }">{{ t('settings.sectionAppearance') }}</text>
			<view class="card" :style="{ backgroundColor: c.cloth }">
				<text class="sub-label" :style="{ color: c.inkFaint }">{{ t('settings.theme') }}</text>
				<view class="seg" :style="{ backgroundColor: c.chip }">
					<view v-for="m in themes" :key="m.id" class="seg-item" :style="m.id == themeMode ? { backgroundColor: c.cloth } : {}" @click="pickTheme(m.id)">
						<text class="seg-text" :style="{ color: m.id == themeMode ? c.ink : c.inkSoft }">{{ m.label }}</text>
					</view>
				</view>
				<text class="sub-label" :style="{ color: c.inkFaint }">{{ t('settings.font') }}</text>
				<view class="seg" :style="{ backgroundColor: c.chip }">
					<view v-for="f in fonts" :key="f.id" class="seg-item" :style="f.id == fontSize ? { backgroundColor: c.cloth } : {}" @click="pickFont(f.id)">
						<text class="seg-text" :style="{ color: f.id == fontSize ? c.ink : c.inkSoft }">{{ f.label }}</text>
					</view>
				</view>
				<text class="preview" :style="{ color: c.ink, fontSize: previewFont, lineHeight: previewLine }">{{ t('settings.fontPreview') }}</text>
			</view>

			<text class="section" :style="{ color: c.inkFaint }">{{ t('settings.sectionNotify') }}</text>
			<view class="card" :style="{ backgroundColor: c.cloth }">
				<view class="row-btn" @click="testNotify">
					<text class="key" :style="{ color: c.ink }">{{ t('settings.testNotify') }}</text>
					<text class="val" :style="{ color: c.inkFaint }">{{ t('settings.testNotifyHint') }}</text>
				</view>
			</view>

			<text class="section" :style="{ color: c.inkFaint }">{{ t('settings.sectionVersion') }}</text>
			<view class="card" :style="{ backgroundColor: c.cloth }">
				<view class="row-btn" @click="manualUpdate">
					<text class="key" :style="{ color: c.ink }">{{ t('settings.checkUpdate') }}</text>
					<text class="val" :style="{ color: c.inkFaint }">{{ currentVer }}</text>
				</view>
			</view>

			<view class="card danger" :style="{ backgroundColor: c.cloth }" @click="unpair">
				<text class="danger-text" :style="{ color: c.red }">{{ t('settings.unpair') }}</text>
			</view>
			<text class="foot" :style="{ color: c.inkFaint }">FlyknitBuddy {{ version }}</text>
		</scroll-view>
	</view>
</template>

<script setup lang="uts">
	import { computed } from 'vue'
	import { setThemeMode, Palette, syncStatusBar, theme } from '../../common/theme.uts'
	import { clearAuth, state } from '../../common/store.uts'
	import { request } from '../../common/api.uts'
	import { disconnect, notifyLocal } from '../../common/socket.uts'
	import { checkUpdate } from '../../common/update.uts'
	import { ModelInfo, bodyFontPx, bodyLinePx, modelLabel, prefs, refreshModels, setAppLocale, setDeepThinking, setFontSize, setModelId, setWebSearch } from '../../common/prefs.uts'
	import { LANG_OPTIONS, i18n, t as _t, tf as _tf } from '../../common/i18n.uts'

	// 模板里不能直接调用 import 的函数（UTS→Kotlin 报 invoke），用本地包装
	function t(key : string) : string {
		return _t(key)
	}

	function tf(key : string, a : string) : string {
		return _tf(key, a)
	}

	type ThemeItem = { id : string, label : string }

	const c = computed<Palette>(() : Palette => theme.c)
	const topInset = uni.getWindowInfo().statusBarHeight.toString() + 'px'
	const machineName = computed(() : string => state.machineName)
	const userName = computed(() : string => state.userName)
	const online = computed(() : boolean => state.computerOnline)
	const server = computed(() : string => state.server)
	const approvals = computed(() : boolean => state.approvalsAllowed)
	const themeMode = computed(() : string => theme.mode)
	const fontSize = computed(() : string => prefs.fontSize)
	const locale = computed(() : string => {
		const _dep = i18n.locale
		return prefs.locale
	})
	const previewFont = computed(() : string => bodyFontPx().toString() + 'px')
	const previewLine = computed(() : string => bodyLinePx().toString() + 'px')
	const modelName = computed(() : string => {
		const _dep = i18n.locale
		return modelLabel()
	})
	const deepThinking = computed(() : boolean => prefs.deepThinking)
	const webSearch = computed(() : boolean => prefs.webSearch)
	const webSearchAvailable = computed(() : boolean => state.webSearchEnabled)
	const version = uni.getAppBaseInfo().appVersion ?? ''
	const currentVer = computed(() : string => {
		const _dep = i18n.locale
		return tf('settings.currentVer', version)
	})
	const themes = computed(() : Array<ThemeItem> => {
		const _dep = i18n.locale
		return [
			{ id: 'system', label: t('settings.themeSystem') } as ThemeItem,
			{ id: 'light', label: t('settings.themeLight') } as ThemeItem,
			{ id: 'dark', label: t('settings.themeDark') } as ThemeItem
		]
	})
	const fonts = computed(() : Array<ThemeItem> => {
		const _dep = i18n.locale
		return [
			{ id: 'small', label: t('settings.fontSmall') } as ThemeItem,
			{ id: 'medium', label: t('settings.fontMedium') } as ThemeItem,
			{ id: 'large', label: t('settings.fontLarge') } as ThemeItem
		]
	})

	function back() {
		uni.navigateBack({})
	}

	function pickTheme(id : string) {
		setThemeMode(id)
		syncStatusBar()
	}

	function pickFont(id : string) {
		setFontSize(id)
	}

	function pickLang(id : string) {
		setAppLocale(id)
	}

	function onDeep(e : UniSwitchChangeEvent) {
		setDeepThinking(e.detail.value)
	}

	function onWeb(e : UniSwitchChangeEvent) {
		if (!state.webSearchEnabled) {
			uni.showToast({ title: t('settings.webSearchOff'), icon: 'none' })
			return
		}
		setWebSearch(e.detail.value)
	}

	function pickModel() {
		void refreshModels().then(() => {
			const items = [t('common.autoFlash')] as Array<string>
			prefs.models.forEach((m : ModelInfo) => {
				items.push(m.name)
			})
			uni.showActionSheet({
				itemList: items,
				success: (r) => {
					if (r.tapIndex == 0) {
						setModelId(0)
					} else {
						const m = prefs.models[r.tapIndex - 1]
						if (m != null) {
							setModelId(m.id)
						}
					}
				}
			})
		})
	}

	function manualUpdate() {
		void checkUpdate(true)
	}

	function testNotify() {
		notifyLocal(t('settings.notifyTitle'), t('settings.notifyBody'))
	}

	function unpair() {
		uni.showModal({
			title: t('settings.unpairTitle'),
			content: t('settings.unpairContent'),
			confirmText: t('settings.unpairConfirm'),
			cancelText: t('common.cancel'),
			success: (r) => {
				if (!r.confirm) {
					return
				}
				request('DELETE', '/api/v1/mobile/me', null).then((_res) => {
					disconnect()
					clearAuth()
					uni.reLaunch({ url: '/pages/pair/pair' })
				})
			}
		})
	}

	onShow(() => {
		syncStatusBar()
	})
</script>

<style>
	.page {
		flex: 1;
	}
	.topbar {
		height: 52px;
		flex-direction: row;
		align-items: center;
		justify-content: space-between;
		padding: 0 8px;
	}
	.back {
		width: 80px;
		height: 44px;
		justify-content: center;
		padding-left: 8px;
	}
	.back-text {
		font-size: 16px;
	}
	.title {
		font-size: 17px;
		font-weight: bold;
	}
	.body {
		flex: 1;
		padding: 0 16px;
	}
	.section {
		font-size: 12px;
		margin: 16px 4px 6px 4px;
	}
	.card {
		border-radius: 14px;
		padding: 0 14px;
	}
	.row {
		flex-direction: row;
		align-items: center;
		justify-content: space-between;
		min-height: 44px;
		border-top-width: 1px;
		border-top-style: solid;
		border-top-color: transparent;
	}
	.sw {
		transform: scale(0.72);
		transform-origin: center right;
	}
	.row-btn {
		min-height: 52px;
		justify-content: center;
		padding: 8px 0;
	}
	.hint {
		font-size: 12px;
		line-height: 18px;
		padding: 0 0 12px 0;
	}
	.key {
		font-size: 15px;
	}
	.val {
		overflow: hidden;
		text-overflow: ellipsis;
		white-space: nowrap;
		font-size: 14px;
		margin-left: 12px;
		flex-shrink: 1;
	}
	.sub-label {
		font-size: 12px;
		margin-top: 12px;
	}
	.preview {
		padding: 4px 0 14px 0;
	}
	.seg {
		flex-direction: row;
		margin: 8px 0 4px 0;
		padding: 3px;
		border-radius: 12px;
	}
	.seg-item {
		flex: 1;
		height: 34px;
		border-radius: 9px;
		align-items: center;
		justify-content: center;
	}
	.seg-text {
		font-size: 13px;
	}
	.danger {
		margin-top: 24px;
		align-items: center;
		justify-content: center;
		min-height: 48px;
	}
	.danger-text {
		font-size: 15px;
	}
	.foot {
		text-align: center;
		font-size: 12px;
		margin: 16px 0 32px 0;
	}
</style>
