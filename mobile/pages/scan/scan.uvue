<template>
	<view class="page" :style="{ backgroundColor: '#000000' }">
		<view class="nav" :style="{ paddingTop: px(statusTop) }">
			<text class="back" @click="cancel">{{ t('common.cancel') }}</text>
			<text class="title">{{ t('scan.title') }}</text>
			<text class="back ghost"></text>
		</view>
		<!-- #ifndef WEB -->
		<camera
			id="pairCamera"
			class="cam"
			mode="scanCode"
			device-position="back"
			flash="off"
			resolution="high"
			@scancode="onScan"
			@error="onCamError"
			@initdone="onInit"
		></camera>
		<!-- #endif -->
		<!-- #ifdef WEB -->
		<view class="ph">
			<text class="ph-t">{{ t('scan.webUnsupported') }}</text>
		</view>
		<!-- #endif -->
		<view class="mask">
			<view class="frame"></view>
			<text class="tip">{{ tip }}</text>
		</view>
	</view>
</template>

<script setup lang="uts">
	import { ref } from 'vue'
	import { t } from '../../common/i18n.uts'
	import { deliverScanResult, deliverScanError } from '../../common/scan.uts'

	const statusTop = ref(24)
	const tip = ref(t('scan.aim'))
	const done = ref(false)

	function px(n : number) : string {
		return n.toString() + 'px'
	}

	function cancel() {
		deliverScanError(t('scan.cancel'))
		uni.navigateBack({})
	}

	function onInit(_ : UniCameraInitDoneEvent) {
		tip.value = t('scan.aim')
	}

	function onCamError(e : UniCameraErrorEvent) {
		const msg = e.detail.errMsg ?? t('scan.cameraDeny')
		deliverScanError(msg)
		uni.navigateBack({})
	}

	function onScan(e : UniCameraScanCodeEvent) {
		if (done.value) {
			return
		}
		const text = (e.detail.result ?? '').trim()
		if (text == '') {
			return
		}
		done.value = true
		deliverScanResult(text)
		uni.navigateBack({})
	}

	onLoad((_ : OnLoadOptions) => {
		try {
			const info = uni.getWindowInfo()
			statusTop.value = info.statusBarHeight ?? 24
		} catch (_) {}
		// #ifdef WEB
		tip.value = t('scan.webUnsupported')
		// #endif
	})
</script>

<style>
	.page {
		flex: 1;
		flex-direction: column;
		position: relative;
	}
	.nav {
		position: absolute;
		left: 0;
		right: 0;
		z-index: 20;
		flex-direction: row;
		align-items: center;
		justify-content: space-between;
		padding-left: 14px;
		padding-right: 14px;
		padding-bottom: 10px;
	}
	.back {
		color: #ffffff;
		font-size: 15px;
		width: 64px;
	}
	.back.ghost {
		opacity: 0;
	}
	.title {
		color: #ffffff;
		font-size: 16px;
		font-weight: bold;
	}
	.cam {
		flex: 1;
		width: 100%;
	}
	.ph {
		flex: 1;
		align-items: center;
		justify-content: center;
		padding: 24px;
	}
	.ph-t {
		color: #ffffff;
		font-size: 14px;
		text-align: center;
	}
	.mask {
		position: absolute;
		left: 0;
		right: 0;
		bottom: 48px;
		align-items: center;
		z-index: 10;
	}
	.frame {
		width: 220px;
		height: 220px;
		border-width: 2px;
		border-style: solid;
		border-color: rgba(255, 255, 255, 0.85);
		border-radius: 16px;
		margin-bottom: 16px;
	}
	.tip {
		color: #ffffff;
		font-size: 13px;
		text-align: center;
		padding: 0 24px;
	}
</style>
