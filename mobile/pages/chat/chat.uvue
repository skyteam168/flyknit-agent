<template>
	<view class="page" :style="{ backgroundColor: c.sunk }" @touchstart="onTouchStart" @touchmove="onTouchMove" @touchend="onTouchEnd" @touchcancel="onTouchEnd">
		<!-- 会话列表：在底层，主界面右推时露出来 -->
		<view class="drawer" :style="{ width: px(drawerWidth), backgroundColor: c.sunk, paddingTop: px(statusBar) }">
			<view class="drawer-head">
				<image class="drawer-logo" src="/static/logo.png" mode="aspectFit"></image>
				<text class="drawer-brand" :style="{ color: c.ink }">FlyknitBuddy</text>
			</view>
			<view class="new-btn" :style="{ backgroundColor: c.indigoWash }" @click="newChat">
				<fk-icon name="jiahao" :color="c.indigo" :size="16"></fk-icon>
				<text class="new-text" :style="{ color: c.indigo }">{{ t('chat.newChat') }}</text>
			</view>
			<scroll-view direction="vertical" class="conv-list" :show-scrollbar="false">
				<view v-for="g in groups" :key="g.label" class="group">
					<text class="group-label" :style="{ color: c.inkFaint }">{{ g.label }}</text>
					<view v-for="cv in g.items" :key="cv.id" class="conv" :style="cv.id == currentId ? { backgroundColor: c.chip } : {}" @click="openConv(cv.id)" @longpress="convMenu(cv.id)">
						<text class="conv-mode" :style="{ color: c.indigo, backgroundColor: c.indigoWash }">{{ modeShort(cv.mode) }}</text>
						<text class="conv-title" :style="{ color: c.ink }" :lines="1">{{ convTitle(cv) }}</text>
					</view>
				</view>
				<text v-if="conversations.length == 0" class="conv-empty" :style="{ color: c.inkFaint }">{{ t('chat.emptyConvs') }}</text>
			</scroll-view>
			<view class="me" :style="{ borderTopColor: c.line, paddingBottom: px(bottomInset + 12) }" @click="openSettings">
				<view class="me-avatar" :style="{ backgroundColor: c.indigo }">
					<text class="me-initial">{{ initial }}</text>
				</view>
				<view class="me-text">
					<text class="me-name" :style="{ color: c.ink }" :lines="1">{{ userName }}</text>
					<text class="me-pc" :style="{ color: c.inkFaint }" :lines="1">{{ machineName }} · {{ computerOnline ? t('chat.pcOnline') : t('chat.pcOffline') }}</text>
				</view>
				<text class="me-gear" :style="{ color: c.inkSoft }">{{ t('chat.settings') }}</text>
			</view>
		</view>

		<!-- 主区域：打开会话列表时整体右移 -->
		<view class="main" :style="{ backgroundColor: c.loom, paddingTop: px(statusBar), transform: 'translateX(' + px(openX) + ')', transitionDuration: dragging ? '0ms' : '220ms' }">
			<view class="topbar">
				<view class="top-row">
					<view class="icon-btn" @click="openDrawer">
						<fk-icon name="menu" :color="c.ink" :size="22"></fk-icon>
					</view>
					<text class="top-name" :style="{ color: c.ink }" :lines="1" @click="openDrawer">{{ topTitle }}</text>
					<view class="icon-btn" @click="newChat">
						<fk-icon name="shuyucaiji" :color="c.ink" :size="22"></fk-icon>
					</view>
				</view>
				<view class="top-status" @click="openDrawer">
					<view class="dot" :style="{ backgroundColor: statusColor }"></view>
					<text class="top-sub" :style="{ color: c.inkFaint }" :lines="1">{{ statusText }}</text>
				</view>
			</view>

			<!-- 模式：和电脑端一样，对话 / 翻译 / 办事 -->
			<view v-if="canSwitchMode" class="seg" :style="{ backgroundColor: c.chip }">
				<view v-for="m in MODES" :key="m.id" class="seg-item" :style="m.id == mode ? { backgroundColor: c.cloth } : {}" @click="setMode(m.id)">
					<text class="seg-text" :style="{ color: m.id == mode ? c.ink : c.inkSoft, fontWeight: m.id == mode ? 'bold' : 'normal' }">{{ m.label }}</text>
				</view>
			</view>
			<scroll-view v-if="mode == 'translate'" direction="horizontal" class="langs">
				<view class="langs-row">
					<text class="langs-label" :style="{ color: c.inkFaint }">{{ t('chat.translateTo') }}</text>
					<view v-for="l in LANGS" :key="l.id" class="lang" :style="{ backgroundColor: l.id == target ? c.indigoWash : c.chip }" @click="setTarget(l.id)">
						<text class="lang-text" :style="{ color: l.id == target ? c.indigo : c.inkSoft }">{{ l.label }}</text>
					</view>
				</view>
			</scroll-view>

			<scroll-view ref="listRef" direction="vertical" class="list" :show-scrollbar="false">
				<!-- 空状态 -->
				<view v-if="messages.length == 0" class="empty">
					<image class="empty-logo" src="/static/logo.png" mode="aspectFit"></image>
					<text class="empty-title" :style="{ color: c.ink }">{{ greeting }}</text>
					<text class="empty-sub" :style="{ color: c.inkSoft }">{{ modeHint }}</text>
					<view v-for="(s, si) in suggestions" :key="si" class="suggest" :style="{ backgroundColor: c.sunk }" @click="useSuggestion(s)">
						<text class="suggest-text" :style="{ color: c.ink }">{{ s }}</text>
					</view>
				</view>

				<view v-for="m in messages" :key="m.id" class="msg">
					<!-- 员工 -->
					<view v-if="m.role == 'user'" class="row-user">
						<text v-if="m.tag != null && m.tag != ''" class="user-tag" :style="{ color: c.indigo }">{{ m.tag }}</text>
						<view v-if="(m.images ?? []).length > 0" class="user-imgs">
							<image
								v-for="(src, ii) in (m.images ?? [])"
								:key="ii"
								class="user-img"
								:src="src"
								mode="aspectFill"
								@click="previewMsgImage(m, ii)"
							></image>
						</view>
						<view v-if="m.content != ''" class="bubble" :style="{ backgroundColor: c.chip }" @longpress="copyText(m.content)">
							<text class="bubble-text" :style="{ color: c.ink, fontSize: chatFont, lineHeight: chatLine }" :selectable="true">{{ m.content }}</text>
						</view>
					</view>

					<!-- 办事：电脑上执行的任务卡片 -->
					<view v-else-if="m.taskId > 0" class="task" :style="{ backgroundColor: c.sunk, borderColor: c.line }">
						<view class="task-head">
							<text class="task-title" :style="{ color: c.inkSoft }">{{ tf('chat.onPc', machineName) }}</text>
							<text class="chip" :style="{ backgroundColor: taskChipBg(m.taskStatus), color: taskChipInk(m.taskStatus) }">{{ taskLabel(m.taskStatus) }}</text>
						</view>
						<!-- 办完了：过程收成一行，点开看每一步 -->
						<view v-if="taskFolded(m)" class="fold" @click="toggleSteps(m.id)">
							<text class="fold-text" :style="{ color: c.inkFaint }">{{ stepsSummary(m) }}</text>
							<text class="fold-chev" :style="{ color: c.inkFaint }">{{ openSteps.includes(m.id) ? t('common.collapse') : t('common.expand') }}</text>
						</view>
						<view v-for="(st, sti) in visibleSteps(m)" :key="sti" class="step">
							<view class="step-dot" :style="{ backgroundColor: c.lineStrong }"></view>
							<text class="step-text" :style="{ color: c.inkSoft }" :lines="2">{{ st }}</text>
						</view>
						<text v-if="m.taskStatus == 'pending' || m.taskStatus == 'running'" class="task-wait" :style="{ color: c.inkFaint }">{{ m.taskStatus == 'pending' ? waitingText : t('chat.taskRunning') }}</text>
						<view v-if="m.taskStatus == 'succeeded' && m.content != ''" class="task-answer" :style="{ borderTopColor: c.line }">
							<md-view :content="m.content" :font-size="prefs.fontSize" :rich-ready="true"></md-view>
						</view>
						<text v-if="m.status == 'error' && m.content != ''" class="err" :style="{ color: c.red }">{{ m.content }}</text>
					</view>

					<!-- 助手 -->
					<view v-else class="row-ai">
						<!-- 联网搜索：胶囊「已搜索到 N 个网页」+ 站点图标，点开看来源 -->
						<view v-if="m.searching == true" class="search-pill" :style="{ backgroundColor: c.sunk, borderColor: c.line }">
							<view class="pulse" :style="{ backgroundColor: c.indigo }"></view>
							<text class="search-pill-text" :style="{ color: c.inkSoft }">{{ t('chat.searching') }}</text>
						</view>
						<view v-else-if="(m.sources ?? []).length > 0" class="sources">
							<view class="search-pill" :style="{ backgroundColor: c.sunk, borderColor: c.line }" @click="toggleSources(m.id)">
								<fk-icon name="hulianwangoff" :color="c.inkSoft" :size="14"></fk-icon>
								<text class="search-pill-text" :style="{ color: c.inkSoft }">{{ tf('chat.searched', (m.sources ?? []).length.toString()) }}</text>
								<view class="fav-stack">
									<image
										v-for="(s, si) in sourcePreview(m)"
										:key="si"
										class="fav"
										:style="{ marginLeft: si == 0 ? '0px' : '-6px' }"
										:src="faviconUrl(s.url)"
										mode="aspectFill"
									></image>
								</view>
								<fk-icon class="search-pill-chev" :name="openSources.includes(m.id) ? 'icchevronmore' : 'xiangyou'" :color="c.inkFaint" :size="12"></fk-icon>
							</view>
							<view v-if="openSources.includes(m.id)" class="source-list">
								<view v-for="(s, si) in m.sources" :key="si" class="source" :style="{ backgroundColor: c.cloth, borderColor: c.line }" @click="openSource(s.url)">
									<image class="source-fav" :src="faviconUrl(s.url)" mode="aspectFill"></image>
									<view class="source-body">
										<text class="source-title" :style="{ color: c.ink }" :lines="1">{{ s.title }}</text>
										<text class="source-host" :style="{ color: c.inkFaint }" :lines="1">{{ sourceHost(s.url) }}</text>
									</view>
								</view>
							</view>
						</view>
						<!-- 深度思考：进行中或可展开的「已思考」 -->
						<view v-if="deepThinking && ((m.reasoning ?? '') != '' || (m.status == 'thinking' && m.content == ''))" class="think-box">
							<view class="think-head" @click="toggleReasoning(m.id)">
								<fk-icon name="aisikao" :color="c.inkFaint" :size="14"></fk-icon>
								<text class="think-title" :style="{ color: c.inkFaint }">{{ thinkTitle(m) }}</text>
								<fk-icon class="think-chev" :name="openReasoning.includes(m.id) || m.status == 'thinking' ? 'icchevronmore' : 'xiangyou'" :color="c.inkFaint" :size="12"></fk-icon>
							</view>
							<text v-if="(openReasoning.includes(m.id) || m.status == 'thinking') && reasoningTail(m) != ''" class="reasoning" :style="{ color: c.inkSoft, borderLeftColor: c.lineStrong }">{{ reasoningTail(m) }}</text>
						</view>
						<view v-if="m.content == '' && m.searching != true && (m.status == 'streaming' || (!deepThinking && m.status == 'thinking'))" class="thinking">
							<view class="pulse" :style="{ backgroundColor: c.indigo }"></view>
							<text class="thinking-text" :style="{ color: c.inkFaint }">{{ t('chat.answering') }}</text>
						</view>
						<!-- contentRev：强制 md-view 跟着流式正文刷新（仅改 prop 时子组件偶发不更新） -->
						<md-view v-else-if="m.content != '' && m.status != 'error'" :content="m.content" :content-rev="state.msgRev" :font-size="prefs.fontSize" :rich-ready="m.status == 'done'"></md-view>
						<text v-else-if="m.status == 'error'" class="err" :style="{ color: c.red }">{{ m.content }}</text>
						<view v-if="(m.status == 'done' || m.status == 'error') && m.content != ''" class="actions">
							<view class="act" @click="copyText(m.content)">
								<fk-icon name="fuzhi" :color="c.inkFaint" :size="18"></fk-icon>
							</view>
							<view class="act" @click="rateMsg(m, 'up')">
								<fk-icon name="dianzan" :color="(m.feedback ?? '') == 'up' ? c.indigo : c.inkFaint" :size="18"></fk-icon>
							</view>
							<view class="act" @click="rateMsg(m, 'down')">
								<fk-icon name="chaping" :color="(m.feedback ?? '') == 'down' ? c.red : c.inkFaint" :size="18"></fk-icon>
							</view>
							<view class="act" @click="regenerate(m)">
								<fk-icon name="shuaxin" :color="c.inkFaint" :size="18"></fk-icon>
							</view>
						</view>
					</view>
				</view>
				<view class="list-end"></view>
			</scroll-view>

			<!-- 输入框 -->
			<view class="composer" :style="{ paddingBottom: px(bottomInset + 8) }">
				<!-- 回答还没完又发的话：排着，回答完按顺序发；发出去之前能撤回、拿回输入框改 -->
				<view v-for="q in queuedHere" :key="q.id" class="queued" :style="{ backgroundColor: c.sunk, borderColor: c.lineStrong }">
					<text class="queued-tag" :style="{ color: c.inkSoft }">{{ t('chat.queue') }}</text>
					<text class="queued-text" :style="{ color: c.ink }" :lines="1">{{ q.text }}</text>
					<text class="queued-btn" :style="{ color: c.indigo }" @click="editQueued(q.id)">{{ t('chat.edit') }}</text>
					<text class="queued-btn" :style="{ color: c.inkFaint }" @click="dropQueued(q.id)">{{ t('chat.withdraw') }}</text>
				</view>
				<text v-if="busyHint != ''" class="busy-hint" :style="{ color: c.inkFaint }">{{ busyHint }}</text>
				<view v-if="pendingImages.length > 0" class="attach-row">
					<view v-for="(img, ii) in pendingImages" :key="ii" class="attach">
						<image class="attach-img" :src="img.path" mode="aspectFill"></image>
						<text class="attach-x" :style="{ color: c.actionInk, backgroundColor: c.red }" @click="dropImage(ii)">×</text>
					</view>
				</view>
				<!-- 模型单独一行，不挤占上传/语音 -->
				<view class="model-row" @click="pickModel">
					<text class="model-label" :style="{ color: c.inkFaint }">{{ t('chat.model') }}</text>
					<text class="model-name" :style="{ color: c.inkSoft }" :lines="1">{{ modelChip }}</text>
					<fk-icon class="model-chev" :name="modelPickerOpen ? 'icchevronless' : 'icchevronmore'" :color="c.inkFaint" :size="12"></fk-icon>
				</view>
				<view class="box" :style="{ backgroundColor: c.cloth, borderColor: c.lineStrong }">
					<textarea
						class="input"
						:style="{ color: c.ink, fontSize: chatFont, lineHeight: chatLine }"
						:value="draft"
						:placeholder="placeholder"
						:placeholder-style="'color:' + c.inkFaint"
						:auto-height="true"
						maxlength="4000"
						confirm-type="send"
						@input="onDraft"
						@confirm="send"
					/>
					<view class="box-tools">
						<view class="tool-row chips">
							<view class="chip-btn" :style="deepThinking ? { backgroundColor: c.indigoWash } : { backgroundColor: c.chip }" @click="toggleDeep">
								<fk-icon name="aisikao" :color="deepThinking ? c.indigo : c.inkSoft" :size="15"></fk-icon>
								<text class="chip-text" :style="{ color: deepThinking ? c.indigo : c.inkSoft }">{{ t('chat.deepThinking') }}</text>
							</view>
							<view class="chip-btn" :style="webSearchOn ? { backgroundColor: c.indigoWash } : { backgroundColor: c.chip }" @click="toggleWeb">
								<fk-icon name="hulianwangoff" :color="webSearchOn ? c.indigo : c.inkSoft" :size="15"></fk-icon>
								<text class="chip-text" :style="{ color: webSearchOn ? c.indigo : c.inkSoft }">{{ t('chat.webSearch') }}</text>
							</view>
						</view>
						<view class="tool-row end">
							<view class="icon-round" :style="{ backgroundColor: c.chip }" @click="attachMenu">
								<fk-icon name="jiahao" :color="c.inkSoft" :size="20"></fk-icon>
							</view>
							<view
								v-if="streaming == null && draft.trim() == '' && pendingImages.length == 0"
								class="icon-round"
								:style="{ backgroundColor: recording ? c.indigoWash : c.chip }"
								@touchstart="voiceStart"
								@touchend="voiceEnd"
								@touchcancel="voiceEnd"
							>
								<fk-icon :name="recording ? 'jianpan' : 'yuyin'" :color="recording ? c.indigo : c.inkSoft" :size="20"></fk-icon>
							</view>
							<view v-else-if="streaming != null && draft.trim() == ''" class="send" :style="{ backgroundColor: c.action }" @click="stop">
								<fk-icon name="tingzhi" :color="c.actionInk" :size="18"></fk-icon>
							</view>
							<view v-else class="send" :style="{ backgroundColor: canSend ? c.action : c.lineStrong }" @click="send" @longpress="sendMenu">
								<fk-icon name="zhixiangshang" :color="c.actionInk" :size="18"></fk-icon>
							</view>
						</view>
					</view>
				</view>
			</view>
			<!-- 半透明遮罩：点按或左滑关闭 -->
			<view v-if="openX > 0" class="mask" :style="{ backgroundColor: c.mask, opacity: openX / drawerWidth * 0.45 }" @click="closeDrawer"></view>
		</view>

		<!-- 电脑上执行到需要确认的操作 -->
		<view v-if="approval != null" class="sheet-mask" :style="{ backgroundColor: c.mask }">
			<view class="sheet" :style="{ backgroundColor: c.cloth, paddingBottom: px(bottomInset + 16) }">
				<text class="sheet-kicker" :style="{ color: c.amber }">{{ t('chat.needConfirm') }}</text>
				<text class="sheet-title" :style="{ color: c.ink }">{{ t('chat.needConfirmTitle') }}</text>
				<view class="sheet-box" :style="{ backgroundColor: c.amberWash }">
					<text class="sheet-summary" :style="{ color: c.ink }" :selectable="true">{{ approvalSummary }}</text>
					<text v-if="approvalDetail != ''" class="sheet-detail" :style="{ color: c.inkSoft }">{{ approvalDetail }}</text>
				</view>
				<text class="sheet-note" :style="{ color: c.inkFaint }">{{ t('chat.needConfirmNote') }}</text>
				<view class="sheet-actions">
					<view class="sheet-btn" :style="{ backgroundColor: c.chip }" @click="answer(false)">
						<text class="sheet-btn-text" :style="{ color: c.ink }">{{ t('chat.reject') }}</text>
					</view>
					<view class="sheet-btn" :style="{ backgroundColor: c.action }" @click="answer(true)">
						<text class="sheet-btn-text" :style="{ color: c.actionInk }">{{ t('chat.approve') }}</text>
					</view>
				</view>
			</view>
		</view>
	</view>
</template>

<script setup lang="uts">
	import { computed, nextTick, ref, watch } from 'vue'
	import { Palette, syncStatusBar, theme } from '../../common/theme.uts'
	import { Approval, Conv, Msg, SearchSource, createConv, currentConv, newId, newMsg, removeConv, renameConv, saveConversations, state, touch } from '../../common/store.uts'
	import { request } from '../../common/api.uts'
	import { answerApproval, connect, sendChat, stopChat } from '../../common/socket.uts'
	import { ModelInfo, bodyFontPx, bodyLinePx, modelLabel, prefs, refreshModels, setDeepThinking, setModelId, setWebSearch } from '../../common/prefs.uts'
	import { PickedImage, pickFromAlbum, takePhoto, transcribeFile, voiceUnsupported } from '../../common/media.uts'
	import { i18n, t as _t, tf as _tf } from '../../common/i18n.uts'
	import FkIcon from '../../components/fk-icon/fk-icon.uvue'

	// 模板里不能直接调用 import 的函数（UTS→Kotlin 报 invoke），用本地包装
	function t(key : string) : string {
		return _t(key)
	}

	function tf(key : string, a : string) : string {
		return _tf(key, a)
	}

	type ModeItem = { id : string, label : string }
	type Group = { label : string, items : Array<Conv> }

	const MODES = computed(() : Array<ModeItem> => {
		const _dep = i18n.locale
		return [
			{ id: 'chat', label: t('chat.modeChat') } as ModeItem,
			{ id: 'translate', label: t('chat.modeTranslate') } as ModeItem,
			{ id: 'agent', label: t('chat.modeAgent') } as ModeItem
		]
	})
	const LANGS = [
		{ id: 'zh', label: '中文' } as ModeItem,
		{ id: 'vi', label: 'Tiếng Việt' } as ModeItem,
		{ id: 'en', label: 'English' } as ModeItem,
		{ id: 'km', label: 'ខ្មែរ' } as ModeItem
	]

	const c = computed<Palette>(() : Palette => theme.c)
	const win = uni.getWindowInfo()
	const statusBar = win.statusBarHeight
	const bottomInset = win.safeAreaInsets.bottom
	const drawerWidth = Math.min(win.windowWidth * 0.82, 320)

	function px(n : number) : string {
		return n.toString() + 'px'
	}

	const mode = ref('chat')
	const target = ref('vi')
	const draft = ref('')
	const listRef = ref<UniScrollViewElement | null>(null)
	const pendingImages = ref<Array<PickedImage>>([] as Array<PickedImage>)
	const openReasoning = ref<Array<string>>([] as Array<string>)
	const openSources = ref<Array<string>>([] as Array<string>)
	const modelPickerOpen = ref(false)
	const recording = ref(false)
	let recorder : RecorderManager | null = null
	const deepThinking = computed(() : boolean => prefs.deepThinking)
	const webSearchOn = computed(() : boolean => prefs.webSearch && state.webSearchEnabled && mode.value == 'chat')
	const modelChip = computed(() : string => modelLabel())
	const chatFont = computed(() : string => {
		const _dep = prefs.fontSize
		return bodyFontPx().toString() + 'px'
	})
	const chatLine = computed(() : string => {
		const _dep = prefs.fontSize
		return bodyLinePx().toString() + 'px'
	})
	const canSend = computed(() : boolean => draft.value.trim() != '' || pendingImages.value.length > 0)

	// ---------- 状态 ----------

	const conversations = computed(() : Array<Conv> => state.conversations)
	const currentId = computed(() : string => state.currentId)
	const conv = computed(() : Conv | null => {
		const id = state.currentId
		const i = state.conversations.findIndex((x : Conv) : boolean => x.id == id)
		return i >= 0 ? state.conversations[i] : null
	})
	/** 依赖 msgRev：流式原地改 content/status 时，必须换一份数组引用，列表才会重绘 */
	const messages = computed(() : Array<Msg> => {
		const _rev = state.msgRev
		const cv = conv.value
		if (cv == null) {
			return [] as Array<Msg>
		}
		return cv.messages.slice()
	})
	const machineName = computed(() : string => state.machineName)
	const userName = computed(() : string => state.userName != '' ? state.userName : state.phoneName)
	const computerOnline = computed(() : boolean => state.computerOnline)
	const initial = computed(() : string => userName.value.length > 0 ? userName.value.substring(0, 1).toUpperCase() : 'F')
	const approval = computed(() : Approval | null => state.approvals.length > 0 ? state.approvals[0] : null)
	const approvalSummary = computed(() : string => approval.value?.summary ?? '')
	const approvalDetail = computed(() : string => approval.value?.detail ?? '')
	/** 正在生成的那条回答（显示「停止」） */
	const streaming = computed(() : Msg | null => {
		const list = messages.value
		for (let i = list.length - 1; i >= 0; i--) {
			const m = list[i]
			if (m.role == 'assistant' && m.taskId == 0 && (m.status == 'thinking' || m.status == 'streaming')) {
				return m
			}
		}
		return null
	})
	/** 对话一旦开始，模式就固定了（和电脑端一样） */
	const canSwitchMode = computed(() : boolean => messages.value.length == 0)

	const topTitle = computed(() : string => {
		const cv = conv.value
		let t = 'FlyknitBuddy'
		if (cv != null && cv.title != '') {
			t = cv.title
		}
		// 顶栏只有一行宽度，过长就截断，避免把状态行挤换行
		return t.length > 16 ? t.substring(0, 16) + '…' : t
	})
	const statusText = computed(() : string => {
		const _dep = i18n.locale
		if (state.socket == 'connecting') return t('chat.connecting')
		if (state.socket != 'open') return t('chat.reconnect')
		const name = state.machineName != '' ? state.machineName : t('common.computer')
		return tf(state.computerOnline ? 'chat.statusOnline' : 'chat.statusOffline', name)
	})
	const statusColor = computed(() : string => {
		if (state.socket != 'open') return c.value.amber
		return state.computerOnline ? c.value.thread : c.value.inkFaint
	})
	const greeting = computed(() : string => {
		const _dep = i18n.locale
		const h = new Date().getHours()
		const part = h < 11 ? t('chat.hiMorning') : (h < 14 ? t('chat.hiNoon') : (h < 18 ? t('chat.hiAfternoon') : t('chat.hiEvening')))
		const name = state.userName
		return name != '' ? part + '，' + name : part
	})
	const modeHint = computed(() : string => {
		const _dep = i18n.locale
		if (mode.value == 'translate') return t('chat.hintTranslate')
		if (mode.value == 'agent') return t('chat.hintAgent')
		return t('chat.hintChat')
	})
	const suggestions = computed(() : Array<string> => {
		const _dep = i18n.locale
		if (mode.value == 'agent') {
			return [t('chat.suggestAgent1'), t('chat.suggestAgent2'), t('chat.suggestAgent3')]
		}
		if (mode.value == 'chat') {
			return [t('chat.suggestChat1'), t('chat.suggestChat2'), t('chat.suggestChat3')]
		}
		return [] as Array<string>
	})
	const placeholder = computed(() : string => {
		const _dep = i18n.locale
		if (mode.value == 'translate') return t('chat.phTranslate')
		if (mode.value == 'agent') return t('chat.phAgent')
		return t('chat.phChat')
	})
	const waitingText = computed(() : string => {
		const _dep = i18n.locale
		return state.computerOnline ? t('chat.waitingOnline') : t('chat.waitingOffline')
	})

	const groups = computed(() : Array<Group> => {
		const _dep = i18n.locale
		const now = new Date()
		const today = new Date(now.getFullYear(), now.getMonth(), now.getDate()).getTime()
		const yesterday = today - 86400000
		const week = today - 6 * 86400000
		const g = [
			{ label: t('chat.groupToday'), items: [] as Array<Conv> } as Group,
			{ label: t('chat.groupYesterday'), items: [] as Array<Conv> } as Group,
			{ label: t('chat.groupWeek'), items: [] as Array<Conv> } as Group,
			{ label: t('chat.groupEarlier'), items: [] as Array<Conv> } as Group
		]
		state.conversations.forEach((cv : Conv) => {
			if (cv.messages.length == 0) {
				return
			}
			const stamp = cv.updatedAt
			const idx = stamp >= today ? 0 : (stamp >= yesterday ? 1 : (stamp >= week ? 2 : 3))
			g[idx].items.push(cv)
		})
		return g.filter((x : Group) : boolean => x.items.length > 0)
	})

	function scrollToEnd() {
		nextTick(() => {
			const el = listRef.value
			if (el != null) {
				el.scrollTop = el.scrollHeight
			}
		})
	}

	// 切到某个已有对话时，模式和语言跟着它走
	watch(conv, (cv : Conv | null) => {
		if (cv != null) {
			mode.value = cv.mode
			target.value = cv.target
		}
		scrollToEnd()
	})
	// 新消息、流式输出时滚到底
	watch(() : string => {
		const list = messages.value
		if (list.length == 0) return ''
		const last = list[list.length - 1]
		return list.length.toString() + ':' + last.content.length.toString() + ':' + last.steps.length.toString() + ':' + last.taskStatus
	}, (_sig : string) => {
		scrollToEnd()
	})

	// ---------- 对话 ----------

	function setMode(m : string) {
		mode.value = m
		const cv = conv.value
		if (cv != null && cv.messages.length == 0) {
			cv.mode = m
		}
	}

	function setTarget(t : string) {
		target.value = t
		const cv = conv.value
		if (cv != null) {
			cv.target = t
			saveConversations()
		}
	}

	function convTitle(cv : Conv) : string {
		if (cv.title != '') return cv.title
		const first = cv.messages.find((m : Msg) : boolean => m.role == 'user')
		return first != null ? first.content : t('chat.newChat')
	}

	function modeShort(m : string) : string {
		if (m == 'translate') return t('chat.modeShortTranslate')
		if (m == 'agent') return t('chat.modeShortAgent')
		return t('chat.modeShortChat')
	}

	function convMenu(id : string) {
		uni.showActionSheet({
			itemList: [t('chat.rename'), t('common.delete')],
			success: (res) => {
				if (res.tapIndex == 0) {
					uni.showModal({
						title: t('chat.renameTitle'),
						editable: true,
						placeholderText: t('chat.renamePh'),
						success: (r) => {
							if (r.confirm && (r.content ?? '').trim() != '') {
								renameConv(id, (r.content ?? '').trim())
							}
						}
					})
				} else if (res.tapIndex == 1) {
					uni.showModal({
						title: t('chat.deleteConv'),
						content: t('chat.deleteContent'),
						confirmText: t('common.delete'),
						cancelText: t('common.cancel'),
						success: (r) => {
							if (r.confirm) {
								removeConv(id)
							}
						}
					})
				}
			}
		})
	}

	function onDraft(e : UniInputEvent) {
		draft.value = e.detail.value
	}

	function copyText(text : string) {
		uni.setClipboardData({ data: text })
	}

	// ---------- 运行中又说的话 ----------

	type Queued = { id : string, convId : string, text : string }
	/** 对话、翻译：回答还没完又发的话，回答完按顺序发（只在本机排着） */
	const queued = ref([] as Array<Queued>)
	const queuedHere = computed(() : Array<Queued> => queued.value.filter((q : Queued) : boolean => q.convId == state.currentId))

	/** 办事：这个对话里电脑还在办（或者还没开始办）的那件事 */
	const runningTask = computed(() : Msg | null => {
		const list = messages.value
		for (let i = list.length - 1; i >= 0; i--) {
			const m = list[i]
			if (m.taskId > 0) {
				return m.taskStatus == 'pending' || m.taskStatus == 'running' ? m : null
			}
		}
		return null
	})
	const busyHint = computed(() : string => {
		const _dep = i18n.locale
		if (draft.value.trim() == '') return ''
		if (runningTask.value != null) return t('chat.busyAgent')
		if (streaming.value != null) return t('chat.busyStream')
		return ''
	})

	function queueLocal(text : string) {
		queued.value.push({ id: newId(), convId: state.currentId, text: text } as Queued)
		draft.value = ''
	}

	function dropQueued(id : string) {
		queued.value = queued.value.filter((q : Queued) : boolean => q.id != id)
	}

	function editQueued(id : string) {
		const i = queued.value.findIndex((q : Queued) : boolean => q.id == id)
		if (i < 0) {
			return
		}
		const text = queued.value[i].text
		queued.value.splice(i, 1)
		draft.value = draft.value.trim() == '' ? text : draft.value + '\n' + text
	}

	async function submitTask(cv : Conv, text : string) {
		const answer = newMsg('assistant', '', 'task')
		answer.taskStatus = 'sending'
		cv.messages.push(answer)
		const live = cv.messages[cv.messages.length - 1]
		const res = await request('POST', '/api/v1/mobile/tasks', { text: text, new_conversation: !cv.agentStarted } as UTSJSONObject)
		if (!res.ok || res.data == null) {
			live.taskId = 0
			live.status = 'error'
			live.content = tf('chat.notToPc', res.error)
			saveConversations()
			return
		}
		const body = res.data as UTSJSONObject
		live.taskId = body.getNumber('id') ?? 0
		live.taskStatus = body.getString('status') ?? 'pending'
		cv.agentStarted = true
		saveConversations()
	}

	async function sendText(text : string, tag : string, images : Array<PickedImage> = []) {
		if (state.socket != 'open' && mode.value != 'agent') {
			connect()
			uni.showToast({ title: t('chat.connectingSend'), icon: 'none' })
			return
		}
		let cv = conv.value
		if (cv == null) {
			cv = createConv(mode.value, target.value)
		}
		const theConv = cv!
		if (theConv.title == '') {
			const seed = text != '' ? text : t('chat.image')
			theConv.title = seed.length > 18 ? seed.substring(0, 18) + '…' : seed
		}
		const user = newMsg('user', text, 'done')
		if (tag != '') {
			user.tag = tag
		}
		const urls = images.map((x : PickedImage) : string => x.dataUrl)
		if (urls.length > 0) {
			user.images = urls
		}
		theConv.messages.push(user)
		touch(theConv)

		if (theConv.mode == 'agent') {
			await submitTask(theConv, text)
			return
		}
		const waitStatus = prefs.deepThinking && theConv.mode != 'translate' ? 'thinking' : 'streaming'
		const answer = newMsg('assistant', '', waitStatus)
		theConv.messages.push(answer)
		// 拿数组里的那份（响应式），流式输出写进它界面才会跟着变
		const live = theConv.messages[theConv.messages.length - 1]
		if (!sendChat(theConv, live, urls)) {
			live.status = 'error'
			live.content = t('chat.noServer')
		}
		saveConversations()
	}

	/** 办事：电脑正在办的时候又说了一句（插话 / 打断 / 排队），交给服务端转给电脑 */
	async function sendInput(task : Msg, text : string, how : string) {
		const cv = conv.value
		if (cv == null) {
			return
		}
		draft.value = ''
		const tag = how == 'steer' ? t('chat.tagSteer') : (how == 'interrupt' ? t('chat.tagInterrupt') : t('chat.tagQueue'))
		const user = newMsg('user', text, 'done')
		user.tag = tag
		cv.messages.push(user)
		touch(cv)
		const res = await request('POST', '/api/v1/mobile/tasks/' + task.taskId.toString() + '/input', { text: text, mode: how } as UTSJSONObject)
		if (!res.ok || res.data == null) {
			const err = newMsg('assistant', tf('chat.notToPc', res.error), 'error')
			cv.messages.push(err)
			saveConversations()
			return
		}
		const body = res.data as UTSJSONObject
		const delivered = body.getString('delivered') ?? ''
		const taskJson = body.getJSON('task')
		if (delivered == 'task' && taskJson != null) {
			// 作为新的一件事排上了：给它一张自己的任务卡片
			const card = newMsg('assistant', '', 'task')
			card.taskId = taskJson.getNumber('id') ?? 0
			card.taskStatus = taskJson.getString('status') ?? 'pending'
			cv.messages.push(card)
		} else if (delivered == 'steer') {
			const clip = text.length > 30 ? text.substring(0, 30) + '…' : text
			task.steps.push(tf('chat.supplement', clip))
		} else if (delivered == 'merged') {
			task.steps.push(t('chat.supplementMerged'))
		}
		saveConversations()
	}

	async function send() {
		const text = draft.value.trim()
		const imgs = pendingImages.value.slice()
		if (text == '' && imgs.length == 0) {
			return
		}
		// 电脑在办事：默认插话；AI 在回答：排到回答之后
		const task = runningTask.value
		if (task != null && mode.value == 'agent') {
			if (text == '') {
				uni.showToast({ title: t('chat.agentNeedText'), icon: 'none' })
				return
			}
			await sendInput(task, text, 'steer')
			return
		}
		if (streaming.value != null) {
			if (text != '') {
				queueLocal(text)
			}
			return
		}
		draft.value = ''
		pendingImages.value = [] as Array<PickedImage>
		await sendText(text, '', imgs)
	}

	function previewMsgImage(m : Msg, index : number) {
		const list = m.images ?? ([] as Array<string>)
		if (list.length == 0) {
			return
		}
		uni.previewImage({
			urls: list,
			current: list[index]
		})
	}

	function stop() {
		const m = streaming.value
		if (m != null) {
			stopChat(m)
		}
	}

	// 回答完了：排着的话按顺序接着发
	watch(streaming, (m : Msg | null) => {
		if (m != null) {
			return
		}
		const i = queued.value.findIndex((q : Queued) : boolean => q.convId == state.currentId)
		if (i < 0) {
			return
		}
		const next = queued.value[i]
		queued.value.splice(i, 1)
		void sendText(next.text, t('chat.tagQueue'))
	})

	/** 长按发送：运行中才有选项 */
	function sendMenu() {
		const text = draft.value.trim()
		if (text == '') {
			return
		}
		const task = runningTask.value
		if (task != null) {
			uni.showActionSheet({
				itemList: [t('chat.steerOpt'), t('chat.interruptOpt'), t('chat.queueOpt')],
				success: (r) => {
					const how = r.tapIndex == 0 ? 'steer' : (r.tapIndex == 1 ? 'interrupt' : 'queue')
					void sendInput(task, text, how)
				}
			})
			return
		}
		if (streaming.value != null) {
			uni.showActionSheet({
				itemList: [t('chat.queueAfterAnswer'), t('chat.interruptSend')],
				success: (r) => {
					if (r.tapIndex == 0) {
						queueLocal(text)
					} else {
						stop()
						draft.value = ''
						void sendText(text, t('chat.tagInterrupt'))
					}
				}
			})
			return
		}
		send()
	}

	function useSuggestion(s : string) {
		draft.value = s
		send()
	}

	// ---------- 办事卡片 ----------

	/** 思考还在进行时，只留最近一段，新到的字能看见 */
	function reasoningTail(m : Msg) : string {
		const r = m.reasoning ?? ''
		if (r.length <= 280) {
			return r
		}
		return '…' + r.substring(r.length - 280)
	}

	function thinkTitle(m : Msg) : string {
		if (m.status == 'thinking' && m.content == '') {
			return t('chat.thinking')
		}
		const ms = m.reasoningMs ?? 0
		if (ms > 0) {
			const sec = Math.max(1, Math.round(ms / 1000))
			return tf('chat.thoughtSec', sec.toString())
		}
		return (m.reasoning ?? '') != '' ? t('chat.thought') : t('chat.thoughtProcess')
	}

	function toggleReasoning(id : string) {
		const i = openReasoning.value.indexOf(id)
		if (i >= 0) {
			openReasoning.value.splice(i, 1)
		} else {
			openReasoning.value.push(id)
		}
	}

	function toggleDeep() {
		if (mode.value == 'translate') {
			uni.showToast({ title: t('chat.noDeepTranslate'), icon: 'none' })
			return
		}
		setDeepThinking(!prefs.deepThinking)
	}

	function toggleWeb() {
		if (mode.value == 'translate') {
			uni.showToast({ title: t('chat.noWebTranslate'), icon: 'none' })
			return
		}
		if (mode.value == 'agent') {
			uni.showToast({ title: t('chat.noWebAgent'), icon: 'none' })
			return
		}
		if (!state.webSearchEnabled) {
			uni.showToast({ title: t('chat.webOff'), icon: 'none' })
			return
		}
		setWebSearch(!prefs.webSearch)
	}

	function sourceHost(url : string) : string {
		const m = url.match(/^https?:\/\/([^\/?#]+)/)
		if (m != null && m.length > 1) {
			return m[1] ?? url
		}
		return url
	}

	function faviconUrl(url : string) : string {
		const host = sourceHost(url)
		if (host == '' || host == url) {
			return ''
		}
		return 'https://www.google.com/s2/favicons?sz=64&domain=' + host
	}

	function sourcePreview(m : Msg) : Array<SearchSource> {
		const list = m.sources ?? ([] as Array<SearchSource>)
		if (list.length <= 4) {
			return list
		}
		return list.slice(0, 4)
	}

	function toggleSources(id : string) {
		const i = openSources.value.indexOf(id)
		if (i >= 0) {
			openSources.value.splice(i, 1)
		} else {
			openSources.value.push(id)
		}
	}

	function openSource(url : string) {
		if (url == '') {
			return
		}
		// uni-app x 不提供 plus / uni.openUrl；外链用复制 + 提示（等同 uni-link 的 copy-link-modal）
		uni.setClipboardData({
			data: url,
			success: () => {
				uni.showModal({
					title: t('chat.openLink'),
					content: t('chat.openLinkBody'),
					showCancel: false,
					confirmText: t('common.ok')
				})
			},
			fail: (_err : any) => {
				uni.showToast({ title: t('chat.copyFail'), icon: 'none' })
			}
		})
	}

	function pickModel() {
		if (modelPickerOpen.value) {
			return
		}
		void refreshModels().then(() => {
			const items = [t('common.autoFlash')] as Array<string>
			prefs.models.forEach((m : ModelInfo) => {
				items.push(m.name + (m.supportsVision ? ' · ' + t('chat.vision') : ''))
			})
			modelPickerOpen.value = true
			uni.showActionSheet({
				itemList: items,
				success: (r) => {
					if (r.tapIndex == 0) {
						setModelId(0)
					} else {
						const m = prefs.models[r.tapIndex - 1]
						if (m != null) {
							setModelId(m.id)
						}
					}
				},
				complete: () => {
					modelPickerOpen.value = false
				}
			})
		})
	}

	function attachMenu() {
		uni.showActionSheet({
			itemList: [t('chat.photo'), t('chat.album')],
			success: (r) => {
				const job = r.tapIndex == 0 ? takePhoto() : pickFromAlbum()
				void job.then((img : PickedImage | null) => {
					if (img != null) {
						pendingImages.value = [img]
					}
				})
			}
		})
	}

	function rateMsg(m : Msg, kind : string) {
		if (m.status != 'done' && m.status != 'error') {
			return
		}
		m.feedback = (m.feedback ?? '') == kind ? '' : kind
		saveConversations()
		if (m.feedback == 'up') {
			uni.showToast({ title: t('chat.liked'), icon: 'none' })
		} else if (m.feedback == 'down') {
			uni.showToast({ title: t('chat.disliked'), icon: 'none' })
		}
	}

	/** 用上一条用户话重问：删掉这条及之后的助手回答，再生成一次 */
	function regenerate(m : Msg) {
		if (streaming.value != null) {
			uni.showToast({ title: t('chat.waitAnswer'), icon: 'none' })
			return
		}
		const cv = conv.value
		if (cv == null || cv.mode == 'agent') {
			return
		}
		if (state.socket != 'open') {
			connect()
			uni.showToast({ title: t('chat.connectingRetry'), icon: 'none' })
			return
		}
		const idx = cv.messages.findIndex((x : Msg) : boolean => x.id == m.id)
		if (idx <= 0) {
			return
		}
		let hasUser = false
		for (let i = idx - 1; i >= 0; i--) {
			if (cv.messages[i].role == 'user' && cv.messages[i].taskId == 0) {
				hasUser = true
				break
			}
		}
		if (!hasUser) {
			uni.showToast({ title: t('chat.noRegen'), icon: 'none' })
			return
		}
		cv.messages.splice(idx, cv.messages.length - idx)
		const waitStatus = prefs.deepThinking && cv.mode != 'translate' ? 'thinking' : 'streaming'
		const answer = newMsg('assistant', '', waitStatus)
		cv.messages.push(answer)
		const live = cv.messages[cv.messages.length - 1]
		if (!sendChat(cv, live)) {
			live.status = 'error'
			live.content = t('chat.noServer')
		}
		touch(cv)
		saveConversations()
	}

	function dropImage(_idx : number) {
		pendingImages.value = [] as Array<PickedImage>
	}

	function voiceStart() {
		// #ifdef WEB
		voiceUnsupported()
		return
		// #endif
		// #ifndef WEB
		try {
			if (recorder == null) {
				recorder = uni.getRecorderManager()
				recorder.onStop((res) => {
					recording.value = false
					void transcribeFile(res.tempFilePath).then((text : string) => {
						if (text.trim() != '') {
							draft.value = draft.value.trim() == '' ? text.trim() : draft.value + text.trim()
						}
					})
				})
				recorder.onError((_err) => {
					recording.value = false
					uni.showToast({ title: t('chat.recFail'), icon: 'none' })
				})
			}
			recording.value = true
			recorder!.start({ format: 'wav', sampleRate: 16000, numberOfChannels: 1 } as RecorderManagerStartOptions)
		} catch (_e) {
			voiceUnsupported()
		}
		// #endif
	}

	function voiceEnd() {
		if (!recording.value || recorder == null) {
			return
		}
		recorder.stop()
	}

	function taskLabel(s : string) : string {
		if (s == 'sending') return t('chat.taskSending')
		if (s == 'pending') return t('chat.taskPending')
		if (s == 'running') return t('chat.taskRunningLabel')
		if (s == 'succeeded') return t('chat.taskDone')
		if (s == 'failed') return t('chat.taskFailed')
		if (s == 'expired') return t('chat.taskExpired')
		return s
	}

	function taskChipBg(s : string) : string {
		if (s == 'succeeded') return c.value.threadWash
		if (s == 'failed' || s == 'expired') return c.value.redWash
		if (s == 'running') return c.value.indigoWash
		return c.value.chip
	}

	function taskChipInk(s : string) : string {
		if (s == 'succeeded') return c.value.thread
		if (s == 'failed' || s == 'expired') return c.value.red
		if (s == 'running') return c.value.indigo
		return c.value.inkSoft
	}

	function lastSteps(steps : Array<string>) : Array<string> {
		return steps.length <= 6 ? steps : steps.slice(steps.length - 6)
	}

	/** 展开了过程的任务卡片（消息 ID） */
	const openSteps = ref([] as Array<string>)

	/** 办完了（成功、失败、超时）且有过程：收成一行 */
	function taskFolded(m : Msg) : boolean {
		return m.steps.length > 0 && m.taskStatus != 'pending' && m.taskStatus != 'running' && m.taskStatus != 'sending'
	}

	function visibleSteps(m : Msg) : Array<string> {
		if (!taskFolded(m)) {
			return lastSteps(m.steps)
		}
		return openSteps.value.includes(m.id) ? m.steps : ([] as Array<string>)
	}

	function toggleSteps(id : string) {
		const i = openSteps.value.indexOf(id)
		if (i >= 0) {
			openSteps.value.splice(i, 1)
		} else {
			openSteps.value.push(id)
		}
	}

	function isRejectedStep(x : string) : boolean {
		return x.startsWith(t('chat.rejectedPrefix')) || x.startsWith('已拒绝：') || x.startsWith('Từ chối: ') || x.startsWith('Rejected: ')
	}

	function stepsSummary(m : Msg) : string {
		const bad = m.steps.filter((x : string) : boolean => isRejectedStep(x)).length
		let text = tf('chat.stepsSummary', m.steps.length.toString())
		if (bad > 0) {
			text += tf('chat.stepsRejected', bad.toString())
		}
		return text
	}

	// ---------- 审批 ----------

	async function answer(approve : boolean) {
		const a = approval.value
		if (a == null) {
			return
		}
		const err = await answerApproval(a, approve)
		if (err != '') {
			uni.showToast({ title: err, icon: 'none' })
		}
	}

	// ---------- 抽屉：左缘右滑打开（主界面右推），左滑关闭；打开时短震动 ----------

	/** 主界面右移距离：0=关，drawerWidth=开 */
	const openX = ref(0)
	const dragging = ref(false)
	let startX = 0
	let startY = 0
	let startOpen = 0
	/** none / maybe / drag：先看手指往哪个方向走，横着走才拖抽屉，竖着走留给列表滚动 */
	let gesture = 'none'
	let didHaptic = false

	function hapticOpen() {
		uni.vibrateShort({
			type: 'medium',
			fail: (_err : any) => {}
		})
	}

	function openDrawer() {
		uni.hideKeyboard()
		dragging.value = false
		const wasClosed = openX.value < drawerWidth
		openX.value = drawerWidth
		if (wasClosed) {
			hapticOpen()
		}
	}

	function closeDrawer() {
		dragging.value = false
		openX.value = 0
		didHaptic = false
	}

	function newChat() {
		// 已经有一个空的新对话就直接用
		const cv = conv.value
		if (cv == null || cv.messages.length > 0) {
			state.currentId = ''
		}
		draft.value = ''
		closeDrawer()
	}

	function openConv(id : string) {
		state.currentId = id
		closeDrawer()
	}

	function onTouchStart(e : UniTouchEvent) {
		if (approval.value != null || e.touches.length == 0) {
			return
		}
		const t = e.touches[0]
		startX = t.clientX
		startY = t.clientY
		startOpen = openX.value
		didHaptic = false
		const open = openX.value > 0
		// 关着时从左边缘右滑打开；开着时在主界面上左滑关闭
		gesture = (open || startX < 48) ? 'maybe' : 'none'
	}

	function onTouchMove(e : UniTouchEvent) {
		if (gesture == 'none' || e.touches.length == 0) {
			return
		}
		const t = e.touches[0]
		const dx = t.clientX - startX
		const dy = t.clientY - startY
		if (gesture == 'maybe') {
			if (Math.abs(dx) < 8 && Math.abs(dy) < 8) {
				return
			}
			if (Math.abs(dy) > Math.abs(dx)) {
				gesture = 'none'
				return
			}
			gesture = 'drag'
			dragging.value = true
			uni.hideKeyboard()
		}
		const next = Math.max(0, Math.min(drawerWidth, startOpen + dx))
		openX.value = next
		// 拖过一半时轻震一下，接近 DeepSeek 打开反馈
		if (!didHaptic && next > drawerWidth * 0.55) {
			didHaptic = true
			hapticOpen()
		}
	}

	function onTouchEnd(_ev : UniTouchEvent) {
		if (gesture == 'drag') {
			if (openX.value > drawerWidth / 2) {
				dragging.value = false
				openX.value = drawerWidth
				if (!didHaptic) {
					hapticOpen()
				}
			} else {
				closeDrawer()
			}
		}
		gesture = 'none'
		dragging.value = false
	}

	function openSettings() {
		closeDrawer()
		uni.navigateTo({ url: '/pages/settings/settings' })
	}

	// 没绑定就去绑定页
	onLoad((_opts : OnLoadOptions) => {
		if (state.token == '') {
			uni.reLaunch({ url: '/pages/pair/pair' })
			return
		}
		const cv = currentConv()
		if (cv != null) {
			mode.value = cv.mode
			target.value = cv.target
		}
	})

	onShow(() => {
		syncStatusBar()
	})
</script>

