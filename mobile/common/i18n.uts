// App 界面三语：中文 / 越南语 / English。文案用键查找，切换语言写在 prefs.locale。

import { reactive } from 'vue'

export type LangItem = { id : string, label : string }

export const LANG_OPTIONS = [
	{ id: 'zh', label: '中文' } as LangItem,
	{ id: 'vi', label: 'Tiếng Việt' } as LangItem,
	{ id: 'en', label: 'English' } as LangItem
]

export const i18n = reactive({
	locale: 'zh'
})

type Dict = Map<string, string>

function d(entries : Array<Array<string>>) : Dict {
	const m = new Map<string, string>()
	entries.forEach((e : Array<string>) => {
		if (e.length >= 2) {
			m.set(e[0], e[1])
		}
	})
	return m
}

