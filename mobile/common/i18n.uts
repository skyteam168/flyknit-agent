const PACKS = new Map<string, Dict>([
	['zh', ZH],
	['vi', VI],
	['en', EN]
])

export function setLocale(locale : string) {
	i18n.locale = (locale == 'vi' || locale == 'en') ? locale : 'zh'
}

export function t(key : string) : string {
	const pack = PACKS.get(i18n.locale) ?? ZH
	const hit = pack.get(key)
	if (hit != null && hit != '') {
		return hit
	}
	return ZH.get(key) ?? key
}

/** 替换文案里的 {0} */
export function tf(key : string, a : string) : string {
	return t(key).split('{0}').join(a)
}
