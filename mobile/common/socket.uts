// 和服务器的一条 WebSocket 长连接：
// - 聊天、翻译：发 {type:'chat'}，服务器先逐字推 chat.reasoning（思考），再逐字推 chat.delta（正文），直到 chat.done / chat.error
// - 办事：电脑上的执行进度 task.event、状态变化 task.updated
// - 审批：电脑上执行到需要确认的操作 approval.request，回答后 approval.closed
// 断了自动重连（2 秒起，最长 30 秒）；每 25 秒 ping 一次，顺便知道电脑在不在线。

import { Approval, Conv, Msg, SearchSource, applyMe, clearAuth, findTaskMsg, notifyMessages, saveConversations, setApprovals, state } from './store.uts'
import { request } from './api.uts'
import { prefs } from './prefs.uts'
import { autoCheckUpdate } from './update.uts'
import { t, tf } from './i18n.uts'

let task : SocketTask | null = null
let retryTimer = 0
let pingTimer = 0
let backoff = 2000
let wantOpen = false
/** 正在生成的回答：请求 ID → 那条助手消息 */
const pending = new Map<string, Msg>()

function wsUrl() : string {
	let base = state.server
	if (base.startsWith('https://')) {
		base = 'wss://' + base.substring(8)
	} else if (base.startsWith('http://')) {
		base = 'ws://' + base.substring(7)
	}
	return base + '/api/v1/mobile/ws?token=' + state.token
}

export function connect() {
	wantOpen = true
	if (task != null || state.token == '' || state.server == '') {
		return
	}
	state.socket = 'connecting'
	const sock = uni.connectSocket({
		url: wsUrl(),
		fail: (_err) => {
			task = null
			scheduleRetry()
		}
	})
	task = sock
	sock.onOpen((_ev) => {
		state.socket = 'open'
		backoff = 2000
		startPing()
		void syncTasks()
		void syncApprovals()
		autoCheckUpdate()
	})
	sock.onMessage((res) => {
		const data = res.data
		if (typeof data == 'string') {
			handle(data as string)
		}
	})
	sock.onClose((res) => {
		task = null
		state.socket = 'closed'
		stopPing()
		failPending(t('chat.socketClosed'))
		// 4401：令牌失效（被解绑、被吊销）；4403：管理员关了手机端或电脑被停用
		const closeCode = (res as UTSJSONObject).getNumber('code') ?? 0
		if (closeCode == 4401) {
			wantOpen = false
			clearAuth()
			uni.reLaunch({ url: '/pages/pair/pair' })
			return
		}
		scheduleRetry()
	})
	sock.onError((_ev) => {
		// onClose 会接着来，在那里重连
	})
}

export function disconnect() {
	wantOpen = false
	if (retryTimer != 0) {
		clearTimeout(retryTimer)
		retryTimer = 0
	}
	stopPing()
	const t = task
	task = null
	if (t != null) {
		t.close({ code: 1000 } as CloseSocketOptions)
	}
	state.socket = 'idle'
}

function scheduleRetry() {
	if (!wantOpen || retryTimer != 0) {
		return
	}
	retryTimer = setTimeout(() => {
		retryTimer = 0
		connect()
	}, backoff)
	backoff = Math.min(backoff * 2, 30000)
}

function startPing() {
	stopPing()
	pingTimer = setInterval(() => {
		send({ type: 'ping' } as UTSJSONObject)
		void syncApprovals()
	}, 25000)
}

function stopPing() {
	if (pingTimer != 0) {
		clearInterval(pingTimer)
		pingTimer = 0
	}
}

function send(obj : UTSJSONObject) : boolean {
	const t = task
	if (t == null || state.socket != 'open') {
		return false
	}
	t.send({ data: JSON.stringify(obj) } as SendSocketMessageOptions)
	return true
}

// ---------- 聊天、翻译 ----------

/** 把这个对话交给模型。answer 是已经放进对话里的空助手消息，回答逐字写进它。
 *  images：这一轮用户消息附带的图（data URL），只挂在最后一条 user 上。
 */
export function sendChat(conv : Conv, answer : Msg, images : Array<string> = []) : boolean {
	const history = [] as Array<UTSJSONObject>
	conv.messages.forEach((m : Msg) => {
		if (m.id == answer.id || m.taskId != 0 || m.status == 'error') {
			return
		}
		if (m.content == '' && m.role != 'user') {
			return
		}
		// 只有「当前这一轮」用户消息带图；更早的图只在本地气泡展示，避免历史里反复塞 base64
		const isLastUser = m.role == 'user' && conv.messages.indexOf(m) == conv.messages.length - 2
		const own = m.images ?? ([] as Array<string>)
		const imgs = images.length > 0 ? images : own
		if (isLastUser && imgs.length > 0) {
			const parts = [] as Array<UTSJSONObject>
			if (m.content != '') {
				parts.push({ type: 'text', text: m.content } as UTSJSONObject)
			}
			imgs.forEach((url : string) => {
				parts.push({ type: 'image_url', image_url: { url: url } } as UTSJSONObject)
			})
			history.push({ role: 'user', content: parts } as UTSJSONObject)
			return
		}
		if (m.content != '') {
			history.push({ role: m.role, content: m.content } as UTSJSONObject)
		} else if (m.role == 'user' && own.length > 0) {
			history.push({ role: 'user', content: '[image]' } as UTSJSONObject)
		}
	})
	const rid = answer.id
	answer.reasoning = ''
	answer.reasoningMs = 0
	answer.searching = false
	answer.sources = [] as Array<SearchSource>
	const payload = {
		type: 'chat',
		id: rid,
		mode: conv.mode == 'translate' ? 'translate' : 'chat',
		target: conv.target,
		conversation_id: conv.id,
		thinking: prefs.deepThinking && conv.mode != 'translate',
		web_search: prefs.webSearch && conv.mode == 'chat' && state.webSearchEnabled,
		messages: history
	} as UTSJSONObject
	if (prefs.modelId > 0) {
		payload['model_id'] = prefs.modelId
	}
	const ok = send(payload)
	if (ok) {
		pending.set(rid, answer)
	}
	return ok
}

export function stopChat(answer : Msg) {
	send({ type: 'chat.stop', id: answer.id } as UTSJSONObject)
	if (pending.has(answer.id)) {
		pending.delete(answer.id)
		answer.status = 'done'
		notifyMessages(true)
		saveConversations()
	}
}

function failPending(reason : string) {
	pending.forEach((m : Msg, _id : string) => {
		m.status = 'error'
		if (m.content == '') {
			m.content = reason
		}
	})
	pending.clear()
	notifyMessages(true)
	saveConversations()
}

// ---------- 收到的消息 ----------

function handle(raw : string) {
	const parsed = JSON.parse(raw)
	if (parsed == null) {
		return
	}
	const ev = parsed as UTSJSONObject
	const type = ev.getString('type') ?? ''
	if (type == 'hello') {
		applyMe(ev)
		const list = ev.getArray('approvals_pending')
		setApprovals([] as Array<Approval>)
		if (list != null) {
			list.forEach((a : any | null) => {
				if (a != null) {
					addApproval(a as UTSJSONObject, false)
				}
			})
		}
		return
	}
	if (type == 'pong') {
		state.computerOnline = ev.getBoolean('online') ?? state.computerOnline
		return
	}
	if (type.startsWith('chat.')) {
		onChat(type, ev)
		return
	}
	if (type == 'task.event') {
		const m = findTaskMsg(ev.getNumber('task') ?? 0)
		if (m != null) {
			const text = ev.getString('text') ?? ''
			if (text != '' && (m.steps.length == 0 || m.steps[m.steps.length - 1] != text)) {
				m.steps.push(text)
				notifyMessages()
				saveConversations()
			}
		}
		return
	}
	if (type == 'task.updated') {
		const t = ev.getJSON('task')
		if (t != null) {
			applyTask(t, true)
		}
		return
	}
	if (type == 'approval.request') {
		const a = ev.getJSON('approval')
		if (a != null) {
			addApproval(a, true)
		}
		return
	}
	if (type == 'approval.closed') {
		const a = ev.getJSON('approval')
		if (a != null) {
			removeApproval(a.getString('id') ?? '')
		}
	}
}

function onChat(type : string, ev : UTSJSONObject) {
	const rid = ev.getString('id') ?? ''
	const m = pending.get(rid)
	if (m == null) {
		return
	}
	if (type == 'chat.searching') {
		m.searching = true
		notifyMessages()
	} else if (type == 'chat.sources') {
		m.searching = false
		const raw = ev.getArray('sources')
		const list = [] as Array<SearchSource>
		if (raw != null) {
			raw.forEach((item : any | null) => {
				if (item == null) {
					return
				}
				const o = item as UTSJSONObject
				const url = o.getString('url') ?? ''
				if (url == '') {
					return
				}
				list.push({
					title: o.getString('title') ?? url,
					url: url,
					snippet: o.getString('snippet') ?? ''
				} as SearchSource)
			})
		}
		m.sources = list
		notifyMessages(true)
	} else if (type == 'chat.start') {
		m.searching = false
		m.status = prefs.deepThinking ? 'thinking' : 'streaming'
		notifyMessages()
	} else if (type == 'chat.thinking' || type == 'chat.reasoning') {
		// 没开深度思考时忽略思考增量，界面保持「正在回答」
		if (!prefs.deepThinking) {
			return
		}
		m.status = 'thinking'
		const piece = ev.getString('text') ?? ''
		if (piece != '') {
			const prev = m.reasoning ?? ''
			let next = prev + piece
			if (next.length > 4000) {
				next = next.substring(next.length - 4000)
			}
			m.reasoning = next
		}
		// 原地改 reasoning/status：不 bump 的话界面会一直停在「正在思考」
		notifyMessages()
	} else if (type == 'chat.delta') {
		if ((m.reasoning ?? '') != '' && (m.reasoningMs ?? 0) == 0) {
			m.reasoningMs = Math.max(1, Date.now() - m.createdAt)
		}
		m.status = 'streaming'
		m.content += ev.getString('text') ?? ''
		notifyMessages()
		saveConversations()
	} else if (type == 'chat.done') {
		const full = ev.getString('text') ?? ''
		// 中途漏掉的增量，用服务端拼好的全文补上
		if (full != '' && full.length >= m.content.length) {
			m.content = full
		}
		if ((m.reasoning ?? '') != '' && (m.reasoningMs ?? 0) == 0) {
			m.reasoningMs = Math.max(1, Date.now() - m.createdAt)
		}
		m.status = 'done'
		pending.delete(rid)
		notifyMessages(true)
		saveConversations()
	} else if (type == 'chat.error') {
		m.status = 'error'
		const reason = ev.getString('message') ?? t('chat.genericError')
		m.content = m.content == '' ? reason : m.content + '\n\n（' + reason + '）'
		pending.delete(rid)
		notifyMessages(true)
		saveConversations()
	}
}

// ---------- 办事 ----------

function taskNotifyTitle(status : string) : string {
	if (status == 'succeeded') return t('chat.taskDoneNotify')
	if (status == 'failed') return t('chat.taskFailNotify')
	if (status == 'expired') return t('chat.taskExpiredNotify')
	return ''
}

/** 服务端的任务状态写回对应的消息；办完了、App 在后台时发一条系统通知 */
function applyTask(body : UTSJSONObject, notify : boolean) {
	const m = findTaskMsg(body.getNumber('id') ?? 0)
	if (m == null) {
		return
	}
	const status = body.getString('status') ?? ''
	const changed = status != m.taskStatus
	m.taskStatus = status
	if (status == 'succeeded') {
		m.content = body.getString('answer') ?? ''
		m.status = 'done'
	} else if (status == 'failed' || status == 'expired') {
		m.content = body.getString('error') ?? ''
		m.status = 'error'
	}
	notifyMessages(true)
	saveConversations()
	const title = taskNotifyTitle(status)
	if (notify && changed && title != '' && !state.foreground) {
		const text = body.getString('text') ?? ''
		notifyLocal(title, text.length > 40 ? text.substring(0, 40) + '…' : text)
	}
}

/** 重新连上后：本地还在「等待 / 执行中」的任务，按服务端的最新状态补齐 */
async function syncTasks() {
	const res = await request('GET', '/api/v1/mobile/tasks?limit=50', null)
	if (!res.ok || res.data == null) {
		return
	}
	const list = res.data as Array<any>
	list.forEach((item : any) => {
		const t = item as UTSJSONObject
		const m = findTaskMsg(t.getNumber('id') ?? 0)
		if (m != null && m.taskStatus != (t.getString('status') ?? '')) {
			applyTask(t, false)
		}
	})
}

// ---------- 审批 ----------

// 按服务端补齐待确认的操作：App 在后台时连接常被系统掐断，推送的确认请求就丢了；
// 回到前台、连上、定时心跳时都来对一遍（新的加上并提醒，已经处理掉的收起）
export async function syncApprovals() {
	if (state.token == '') {
		return
	}
	const res = await request('GET', '/api/v1/mobile/approvals', null)
	if (!res.ok || res.data == null) {
		return
	}
	const list = res.data as Array<any>
	const ids : string[] = []
	list.forEach((item : any) => {
		const a = item as UTSJSONObject
		ids.push(a.getString('id') ?? '')
		addApproval(a, true)
	})
	const gone = state.approvals.filter((x : Approval) : boolean => ids.indexOf(x.id) < 0)
	gone.forEach((x : Approval) => {
		removeApproval(x.id)
	})
}

function addApproval(a : UTSJSONObject, notify : boolean) {
	const id = a.getString('id') ?? ''
	if (id == '' || state.approvals.findIndex((x : Approval) : boolean => x.id == id) >= 0) {
		return
	}
	const item = {
		id: id,
		task: a.getNumber('task') ?? 0,
		summary: a.getString('summary') ?? '',
		detail: a.getString('detail') ?? '',
		risk: a.getString('risk') ?? '',
		expiresIn: a.getNumber('expires_in') ?? 0
	} as Approval
	const next = state.approvals.slice()
	next.push(item)
	setApprovals(next)
	const m = findTaskMsg(item.task)
	if (m != null) {
		m.steps.push(tf('chat.waitConfirm', item.summary))
		notifyMessages()
		saveConversations()
	}
	if (notify && !state.foreground) {
		notifyLocal(t('chat.approvalNotify'), item.summary)
	}
}

function removeApproval(id : string) {
	if (state.approvals.findIndex((x : Approval) : boolean => x.id == id) >= 0) {
		setApprovals(state.approvals.filter((x : Approval) : boolean => x.id != id))
	}
}

export async function answerApproval(a : Approval, approve : boolean) : Promise<string> {
	const res = await request('POST', '/api/v1/mobile/approvals/' + a.id, { approve: approve } as UTSJSONObject)
	removeApproval(a.id)
	const m = findTaskMsg(a.task)
	if (m != null) {
		m.steps.push(approve ? tf('chat.approvedStep', a.summary) : tf('chat.rejectedStep', a.summary))
		notifyMessages()
		saveConversations()
	}
	return res.ok ? '' : res.error
}

// ---------- 系统通知 ----------

export function notifyLocal(title : string, content : string) {
	uni.createPushMessage({
		title: title,
		content: content,
		fail: (_err) => {
			// 没开通知权限之类：不影响使用
		}
	} as CreatePushMessageOptions)
}
