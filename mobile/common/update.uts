// App 升级：问服务器有没有比当前 versionCode 更大的已发布版本，有就提示，员工同意后下载并调系统安装。
// 安装包在后台「手机端 → App 版本」上传、发布。

import { request } from './api.uts'
import { state } from './store.uts'
import { t, tf } from './i18n.uts'

const LAST_CHECK_KEY = 'fk.updateCheckedAt'
const AUTO_INTERVAL = 6 * 3600 * 1000

let checking = false

function currentCode() : number {
	const code = uni.getAppBaseInfo().appVersionCode ?? '0'
	const n = parseInt(code)
	return isNaN(n) ? 0 : n
}

/** 打开 App、重新连上时：6 小时内问过就不再问；有新版本弹窗提示 */
export function autoCheckUpdate() {
	const last = uni.getStorageSync(LAST_CHECK_KEY)
	if (last != null && typeof last == 'number' && Date.now() - (last as number) < AUTO_INTERVAL) {
		return
	}
	void checkUpdate(false)
}

/** manual：设置里点「检查更新」，没有新版本也告诉员工一声 */
export async function checkUpdate(manual : boolean) : Promise<void> {
	if (checking || state.token == '') {
		return
	}
	checking = true
	const res = await request('GET', '/api/v1/mobile/update?version_code=' + currentCode().toString(), null)
	checking = false
	uni.setStorageSync(LAST_CHECK_KEY, Date.now())
	if (!res.ok || res.data == null) {
		if (manual) {
			uni.showToast({ title: tf('update.checkingFail', res.error), icon: 'none' })
		}
		return
	}
	const u = res.data as UTSJSONObject
	if (!(u.getBoolean('available') ?? false)) {
		if (manual) {
			uni.showToast({ title: t('update.latest'), icon: 'none' })
		}
		return
	}
	const name = u.getString('version_name') ?? ''
	const notes = u.getString('notes') ?? ''
	const path = u.getString('download_path') ?? ''
	uni.showModal({
		title: tf('update.found', name),
		content: notes != '' ? notes : t('update.defaultNotes'),
		confirmText: t('update.download'),
		cancelText: t('update.later'),
		success: (r) => {
			if (r.confirm) {
				download(state.server + path)
			}
		}
	})
}

function download(url : string) {
	uni.showLoading({ title: t('update.downloading') })
	uni.downloadFile({
		url: url,
		success: (res) => {
			uni.hideLoading()
			if (res.statusCode != 200) {
				uni.showToast({ title: tf('update.downloadFail', res.statusCode.toString()), icon: 'none' })
				return
			}
			uni.installApk({
				filePath: res.tempFilePath,
				fail: (err) => {
					uni.showToast({ title: tf('update.installFail', err.errMsg), icon: 'none' })
				}
			})
		},
		fail: (err) => {
			uni.hideLoading()
			uni.showToast({ title: tf('update.downloadFail', err.errMsg), icon: 'none' })
		}
	})
}
