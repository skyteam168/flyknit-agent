// 相册选图、拍照、语音转写（有 ASR 走服务器；没有就提示）。
// 读图：走 uni.getFileSystemManager 读成 base64（App/鸿蒙支持）；蒸汽模式下页面不能调原生 API，故不引 java./Foundation。
// Web 端 getFileSystemManager 不支持，改用 uni.request 取 arraybuffer 再转 base64。

import { state } from './store.uts'
import { t, tf } from './i18n.uts'

export type PickedImage = {
	path : string
	/** data:image/jpeg;base64,... 发给模型用 */
	dataUrl : string
}

function guessMime(path : string) : string {
	const lower = path.toLowerCase()
	if (lower.endsWith('.png')) return 'image/png'
	if (lower.endsWith('.webp')) return 'image/webp'
	if (lower.endsWith('.gif')) return 'image/gif'
	return 'image/jpeg'
}

function readViaFsManager(path : string) : Promise<string> {
	return new Promise<string>((resolve, reject) => {
		try {
			const fs = uni.getFileSystemManager()
			fs.readFile({
				filePath: path,
				encoding: 'base64',
				success: (res) => {
					resolve('' + (res.data as string))
				},
				fail: (err) => {
					reject(err.errMsg)
				}
			})
		} catch (e) {
			reject('' + e)
		}
	})
}

// #ifdef WEB
function readViaWeb(path : string) : Promise<string> {
	return new Promise<string>((resolve, reject) => {
		uni.request({
			url: path,
			method: 'GET',
			responseType: 'arraybuffer',
			success: (res) => {
				try {
					const buf = res.data as ArrayBuffer
					const b64 = uni.arrayBufferToBase64(buf)
					resolve(b64)
				} catch (e) {
					reject('' + e)
				}
			},
			fail: (err) => {
				reject(err.errMsg)
			}
		})
	})
}
// #endif

function readAsDataUrl(path : string) : Promise<string> {
	const mime = guessMime(path)
	return new Promise<string>((resolve, reject) => {
		const done = (b64 : string) => {
			if (b64 == '') {
				reject('empty')
				return
			}
			resolve('data:' + mime + ';base64,' + b64)
		}

		// #ifdef WEB
		readViaWeb(path).then(done).catch((msg) => {
			reject(msg)
		})
		return
		// #endif

		// App / 鸿蒙：getFileSystemManager 读成 base64
		readViaFsManager(path).then(done).catch((msg) => {
			reject(msg)
		})
	})
}

function pick(source : string) : Promise<PickedImage | null> {
	return new Promise<PickedImage | null>((resolve) => {
		uni.chooseImage({
			count: 1,
			sizeType: ['compressed'],
			sourceType: [source],
			success: (res) => {
				const path = res.tempFilePaths.length > 0 ? res.tempFilePaths[0] : ''
				if (path == '') {
					resolve(null)
					return
				}
				readAsDataUrl(path).then((dataUrl) => {
					resolve({ path: path, dataUrl: dataUrl } as PickedImage)
				}).catch((msg) => {
					uni.showToast({ title: tf('media.readImageFail', '' + msg), icon: 'none' })
					resolve(null)
				})
			},
			fail: (_err) => {
				resolve(null)
			}
		})
	})
}

export function pickFromAlbum() : Promise<PickedImage | null> {
	return pick('album')
}

export function takePhoto() : Promise<PickedImage | null> {
	return pick('camera')
}

/**
 * 录音后交给服务端转写。电脑端同一套 /api/v1/speech/transcribe；
 * 没有配语音模型时会失败，提示员工改用打字。
 */
export async function transcribeFile(filePath : string) : Promise<string> {
	if (state.token == '' || state.server == '') {
		return ''
	}
	return new Promise<string>((resolve) => {
		uni.uploadFile({
			url: state.server + '/api/v1/mobile/speech/transcribe',
			filePath: filePath,
			name: 'audio',
			formData: { audio_format: 'wav' } as UTSJSONObject,
			header: { Authorization: 'Bearer ' + state.token },
			success: (res) => {
				if (res.statusCode < 200 || res.statusCode >= 300) {
					uni.showToast({ title: t('media.asrUnavailable'), icon: 'none' })
					resolve('')
					return
				}
				try {
					const body = JSON.parse(res.data) as UTSJSONObject
					resolve(body.getString('text') ?? '')
				} catch (_e) {
					resolve('')
				}
			},
			fail: (_err) => {
				uni.showToast({ title: t('media.asrFail'), icon: 'none' })
				resolve('')
			}
		})
	})
}

/** 浏览器端没有录音基座时，用这个占位提示 */
export function voiceUnsupported() {
	uni.showToast({ title: t('media.voiceWeb'), icon: 'none' })
}
