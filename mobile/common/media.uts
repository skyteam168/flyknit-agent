// 相册选图、拍照、语音转写（有 ASR 走服务器；没有就提示）。
// 读图：App 端不用 getFileSystemManager（Android/iOS 常未实现，会 TypeError），改走原生读文件。

import { state } from './store.uts'
import { t, tf } from './i18n.uts'

// #ifdef APP-ANDROID
import File from 'java.io.File'
import FileInputStream from 'java.io.FileInputStream'
import ByteArrayOutputStream from 'java.io.ByteArrayOutputStream'
import InputStream from 'java.io.InputStream'
import Base64 from 'android.util.Base64'
import Uri from 'android.net.Uri'
// UTSAndroid 是 App-Android 内置对象，不要 import DCloudUTSAndroid（打包会 Could not resolve）
// #endif

// #ifdef APP-IOS
import NSData from 'Foundation.NSData'
// UTSiOS 是 App-iOS 内置对象，不要从 DCloudUTSFoundation import
// #endif

export type PickedImage = {
	path : string
	/** data:image/jpeg;base64,... 发给模型用 */
	dataUrl : string
}

function guessMime(path : string) : string {
	const lower = path.toLowerCase()
	if (lower.endsWith('.png')) return 'image/png'
	if (lower.endsWith('.webp')) return 'image/webp'
	if (lower.endsWith('.gif')) return 'image/gif'
	return 'image/jpeg'
}

function stripFileScheme(path : string) : string {
	if (path.indexOf('file://') == 0) {
		return path.substring(7)
	}
	return path
}

// #ifdef APP-ANDROID
/** Android：file 路径或 content:// 都读成 base64（无 data: 前缀） */
function androidFileToBase64(path : string) : string {
	let stream : InputStream | null = null
	try {
		if (path.indexOf('content://') == 0) {
			const activity = UTSAndroid.getUniActivity()
			if (activity == null) {
				return ''
			}
			stream = activity.getContentResolver().openInputStream(Uri.parse(path))
		} else {
			const abs = UTSAndroid.convert2AbsFullPath(stripFileScheme(path))
			stream = new FileInputStream(new File(abs))
		}
		if (stream == null) {
			return ''
		}
		const bos = new ByteArrayOutputStream()
		const buffer = ByteArray(8192)
		let n = stream!.read(buffer)
		while (n > 0) {
			bos.write(buffer, 0, n)
			n = stream!.read(buffer)
		}
		stream!.close()
		stream = null
		return Base64.encodeToString(bos.toByteArray(), Base64.NO_WRAP) ?? ''
	} catch (_) {
		try {
			stream?.close()
		} catch (_) { }
		return ''
	}
}
// #endif

// #ifdef APP-IOS
function iosFileToBase64(path : string) : string {
	try {
		const abs = UTSiOS.convert2AbsFullPath(stripFileScheme(path))
		const data = NSData.dataWithContentsOfFile(abs)
		if (data == null) {
			return ''
		}
		return data.base64EncodedStringWithOptions(0)
	} catch (_) {
		return ''
	}
}
// #endif

function readViaFsManager(path : string) : Promise<string> {
	return new Promise<string>((resolve, reject) => {
		try {
			const fs = uni.getFileSystemManager()
			fs.readFile({
				filePath: path,
				encoding: 'base64',
				success: (res) => {
					resolve('' + (res.data as string))
				},
				fail: (err) => {
					reject(err.errMsg)
				}
			})
		} catch (e) {
			reject('' + e)
		}
	})
}

// #ifdef WEB
function readViaWeb(path : string) : Promise<string> {
	return new Promise<string>((resolve, reject) => {
		uni.request({
			url: path,
			method: 'GET',
			responseType: 'arraybuffer',
			success: (res) => {
				try {
					const buf = res.data as ArrayBuffer
					const b64 = uni.arrayBufferToBase64(buf)
					resolve(b64)
				} catch (e) {
					reject('' + e)
				}
			},
			fail: (err) => {
				reject(err.errMsg)
			}
		})
	})
}
// #endif

function readAsDataUrl(path : string) : Promise<string> {
	const mime = guessMime(path)
	return new Promise<string>((resolve, reject) => {
		const done = (b64 : string) => {
			if (b64 == '') {
				reject('empty')
				return
			}
			resolve('data:' + mime + ';base64,' + b64)
		}

		// #ifdef APP-ANDROID
		try {
			const b64 = androidFileToBase64(path)
			if (b64 != '') {
				done(b64)
				return
			}
		} catch (_) { }
		// #endif

		// #ifdef APP-IOS
		try {
			const b64 = iosFileToBase64(path)
			if (b64 != '') {
				done(b64)
				return
			}
		} catch (_) { }
		// #endif

		// #ifdef WEB
		readViaWeb(path).then(done).catch((msg) => {
			reject(msg)
		})
		return
		// #endif

		// 鸿蒙等仍支持 getFileSystemManager 的平台
		readViaFsManager(path).then(done).catch((msg) => {
			reject(msg)
		})
	})
}

function pick(source : string) : Promise<PickedImage | null> {
	return new Promise<PickedImage | null>((resolve) => {
		uni.chooseImage({
			count: 1,
			sizeType: ['compressed'],
			sourceType: [source],
			success: (res) => {
				const path = res.tempFilePaths.length > 0 ? res.tempFilePaths[0] : ''
				if (path == '') {
					resolve(null)
					return
				}
				readAsDataUrl(path).then((dataUrl) => {
					resolve({ path: path, dataUrl: dataUrl } as PickedImage)
				}).catch((msg) => {
					uni.showToast({ title: tf('media.readImageFail', '' + msg), icon: 'none' })
					resolve(null)
				})
			},
			fail: (_) => {
				resolve(null)
			}
		})
	})
}

export function pickFromAlbum() : Promise<PickedImage | null> {
	return pick('album')
}

export function takePhoto() : Promise<PickedImage | null> {
	return pick('camera')
}

/**
 * 录音后交给服务端转写。电脑端同一套 /api/v1/speech/transcribe；
 * 没有配语音模型时会失败，提示员工改用打字。
 */
export async function transcribeFile(filePath : string) : Promise<string> {
	if (state.token == '' || state.server == '') {
		return ''
	}
	return new Promise<string>((resolve) => {
		uni.uploadFile({
			url: state.server + '/api/v1/mobile/speech/transcribe',
			filePath: filePath,
			name: 'audio',
			formData: { audio_format: 'wav' } as UTSJSONObject,
			header: { Authorization: 'Bearer ' + state.token },
			success: (res) => {
				if (res.statusCode < 200 || res.statusCode >= 300) {
					uni.showToast({ title: t('media.asrUnavailable'), icon: 'none' })
					resolve('')
					return
				}
				try {
					const body = JSON.parse(res.data) as UTSJSONObject
					resolve(body.getString('text') ?? '')
				} catch (_) {
					resolve('')
				}
			},
			fail: (_) => {
				uni.showToast({ title: t('media.asrFail'), icon: 'none' })
				resolve('')
			}
		})
	})
}

/** 浏览器端没有录音基座时，用这个占位提示 */
export function voiceUnsupported() {
	uni.showToast({ title: t('media.voiceWeb'), icon: 'none' })
}
